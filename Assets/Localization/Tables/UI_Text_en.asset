  - m_Id: 6700000000039
    m_Localized: 'Press 1 to phase through blocks.Press Space to wipe out overlaps
      and launch missiles. '
    m_Metadata:
      m_Items: []
  - m_Id: 6700000000040
    m_Localized: Press 2 to clear the top block of each row and generate missiles.
    m_Metadata:
      m_Items: []
  - m_Id: 6700000000041
    m_Localized: 'Press 3 to fill all enclosed areas with blocks.Completed rows count
      as valid clears. Clearing void blocks generates no missiles. '
