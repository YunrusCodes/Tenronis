  - m_Id: 6700000000023
    m_Localized: Erase (Key 1) - Cost
    m_Metadata:
      m_Items: []
  - m_Id: 6700000000024
    m_Localized: Execution (Key 2) - Cost
    m_Metadata:
      m_Items: []
  - m_Id: 6700000000025
