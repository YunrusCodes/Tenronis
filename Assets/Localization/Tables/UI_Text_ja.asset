    m_Localized: "\u73FE\u5728\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u53BB\u3059\u308B\u3068{0}\u767A\u306E\u30DF\u30B5\u30A4\u30EB\u304C\u751F\u6210\u3055\u308C\u307E\u3059"
