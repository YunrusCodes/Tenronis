  - m_Id: 6700000000032
    m_Localized: "\u30D6\u30ED\u30C3\u30AF\u751F\u6210\u5F8C0.2\u79D2\u4EE5\u5185\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B\u3068\u53CD\u6483\u3092\u767A\u52D5"
