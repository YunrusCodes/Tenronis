      m_Items: []
  - m_Id: 6700000000035
    m_Localized: "\u885D\u6483\u7832\u306E\u89E3\u653E\u3068\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u306E\u4F7F\u7528\u306B\u306FCP\u3092\u6D88\u8CBB"
