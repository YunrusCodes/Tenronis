  m_Name: Stage_8_Crasher
  m_EditorClassIdentifier: 
  stageName: "\u96D9\u89D2"
  stageNameEn: Twin-Horn Sovereign
  stageNameJa: "\u53CC\u89D2"
  stageIndex: 8
  isBossStage: 0
  description: "\u4ED6\u662F\u7D42\u9EDE?\u9084\u662F\u60E1\u5922\u771F\u6B63\u958B\u59CB\u7684\u5730\u65B9?\n\u6709\u4EBA\u8AAA\uFF0C\u90A3\u5C0D\u9AD8\u8209\u7684\u96D9\u89D2\uFF0C\u662F\u7121\u6578\u6050\u61FC\u5806\u758A\u5F8C\u5F62\u6210\u7684\u738B\u51A0\u3002\n\u7576\u4ED6\u964D\u81E8\uFF0C\u4E16\u754C\u6703\u9677\u5165\u77ED\u66AB\u7684\u975C\u6B62\uFF0C\u5F77\u5F7F\u6240\u6709\u60E1\u5922\u90FD\u5728\u5411\u4ED6\u4FEF\u9996\u7A31\u81E3\u3002\n\u90A3\u96D9\u51B7\u5149\u9583\u720D\u7684\u773C\u775B\u6383\u904E\u4E4B\u8655\uFF0C\u610F\u5FD7\u4E0D\u518D\u6399\u624E\uFF0C\u53EA\u5269\u4E0B\u7B49\u5F85\u88C1\u6C7A\u7684\u7A7A\u767D\u3002"
  descriptionEn: "Is it the end\u2014or the place where nightmares truly begin?\nSome
    say the twin horns raised high are a crown formed from countless stacked fears.\nWhen
    it descends, the world falls into a brief stillness, as if all nightmares bow
    before it.\nWherever its cold, gleaming eyes pass, will no longer struggles\u2014only
    an empty calm remains, awaiting judgment."
  descriptionJa: "\u305D\u308C\u306F\u7D42\u7109\u306A\u306E\u304B\u3001\u305D\u308C\u3068\u3082\u60AA\u5922\u304C\u672C\u5F53\u306B\u59CB\u307E\u308B\u5834\u6240\u306A\u306E\u304B\u3002\n\u9AD8\u304F\u63B2\u3052\u3089\u308C\u305F\u4E8C\u672C\u306E\u89D2\u306F\u3001\u7121\u6570\u306E\u6050\u6016\u304C\u7A4D\u307F\u91CD\u306A\u3063\u3066\u5F62\u4F5C\u3089\u308C\u305F\u738B\u51A0\u3060\u3068\u8A00\u308F\u308C\u3066\u3044\u308B\u3002\n\u5F7C\u304C\u964D\u81E8\u3059\u308B\u3068\u3001\u4E16\u754C\u306F\u675F\u306E\u9593\u306E\u9759\u6B62\u306B\u5305\u307E\u308C\u3001\u3059\u3079\u3066\u306E\u60AA\u5922\u304C\u5F7C\u306B\u8DEA\u3044\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u306B\u611F\u3058\u3089\u308C\u308B\u3002\n\u51B7\u305F\u3044\u5149\u3092\u5BBF\u3057\u305F\u305D\u306E\u53CC\u773C\u304C\u6383\u904E\u3057\u305F\u5148\u3067\u306F\u3001\u610F\u5FD7\u306F\u3082\u306F\u3084\u6297\u308F\u305A\u3001\u88C1\u304D\u3092\u5F85\u3064\u7A7A\u767D\u3060\u3051\u304C\u6B8B\u3055\u308C\u308B\u3002"
