  m_Name: Stage_8_Crasher
  m_EditorClassIdentifier: 
  stageName: "\u96D9\u89D2"
  stageNameEn: Twin-Horn Sovereign
  stageNameJa: "\u53CC\u89D2"
  stageIndex: 8
  isBossStage: 0
  description: "\u80CC\u666F\u88E1\u90A3\u4E9B\u5713\u5F62\uFF0C\u662F\u5728\u770B\u8457\u4ED6\uFF0C\u5C31\u50CF\u6240\u6709\u60E1\u5922\u90FD\u5728\u7B49\u4ED6\u958B\u53E3\u3002\n\u4ED6\u4E0D\u662F\u7D42\u9EDE\uFF0C\u4ED6\u662F\u67D0\u500B\u8A08\u7B97\u7684\u7B54\u6848\u3002\n\u7576\u4ED6\u964D\u81E8\uFF0C\u6642\u9593\u6C92\u6709\u505C\u6B62\u2014\u2014\u662F\u6240\u6709\u5176\u4ED6\u6771\u897F\u505C\u6B62\u4E86\uFF0C\u53EA\u6709\u4ED6\u7E7C\u7E8C\u79FB\u52D5\u3002\n\u90A3\u96D9\u773C\u6383\u904E\u4F60\u7684\u6642\u5019\uFF0C\u4F60\u611F\u5230\u7684\u4E0D\u662F\u6050\u61FC\uFF0C\u800C\u662F\u4E00\u7A2E\u5947\u7279\u7684\u6E05\u9192\uFF1A\u4F60\u7D42\u65BC\u7406\u89E3\u4E86\u67D0\u4EF6\u4E8B\uFF0C\u4F46\u4F60\u4E0D\u77E5\u9053\u90A3\u4EF6\u4E8B\u662F\u4EC0\u9EBC\u3002"
  descriptionEn: "Those shapes in the background are watching it\u2014as though every nightmare is waiting for it to speak.\nIt is not the end. It is the answer to a calculation.\nWhen it descends, time does not stop\u2014everything else stops. Only it keeps moving.\nWhen its gaze sweeps over you, what you feel is not fear. It is a strange lucidity: you finally understand something, but you cannot tell what that something is."
  descriptionJa: "\u80CC\u666F\u306B\u898B\u3048\u308B\u5186\u5F62\u306E\u3082\u306E\u306F\u305D\u308C\u3092\u898B\u3066\u3044\u308B\u2014\u2014\u3059\u3079\u3066\u306E\u60AA\u5922\u304C\u305D\u308C\u306E\u8A00\u8449\u3092\u5F85\u3063\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u306B\u3002\n\u7D42\u70B9\u3067\u306F\u306A\u3044\u3002\u3042\u308B\u8A08\u7B97\u306E\u7B54\u3048\u3060\u3002\n\u305D\u308C\u304C\u964D\u81E8\u3059\u308B\u3068\u304D\u3001\u6642\u9593\u306F\u6B62\u307E\u3089\u306A\u3044\u2014\u2014\u4ED6\u306E\u3059\u3079\u3066\u304C\u6B62\u307E\u308A\u3001\u305D\u308C\u3060\u3051\u304C\u52D5\u304D\u7D9A\u3051\u308B\u3002\n\u305D\u306E\u8996\u7DDA\u304C\u3042\u306A\u305F\u3092\u6383\u904E\u3059\u308B\u3068\u304D\u3001\u611F\u3058\u308B\u306E\u306F\u6050\u6016\u3067\u306F\u306A\u3044\u3002\u5947\u5999\u306A\u660E\u6670\u3055\u3060\uFF1A\u3064\u3044\u306B\u4F55\u304B\u3092\u7406\u89E3\u3057\u305F\u304C\u3001\u305D\u308C\u304C\u4F55\u306A\u306E\u304B\u306F\u308F\u304B\u3089\u306A\u3044\u3002"
