  m_Name: Stage_3_Striker
  m_EditorClassIdentifier: 
  stageName: "\u566C\u591C\u9B54"
  stageNameEn: Night Devourer
  stageNameJa: "\u566C\u591C\u9B54"
  stageIndex: 3
  isBossStage: 0
  description: "\u4ED6\u6700\u521D\u662F\u4F55\u7A2E\u5F62\u614B?\u7121\u4EBA\u77E5\u66C9\uFF0C\u6709\u4EBA\u8A8D\u70BA\u9ED1\u6697\u672C\u8EAB\u5B78\u6703\u4E86\u98E2\u9913\u3002\n\u51E1\u662F\u4ED6\u5F98\u5F8A\u4E4B\u5730\uFF0C\u71C8\u706B\u6703\u9010\u4E00\u7184\u6EC5\uFF0C\u52C7\u6C23\u6703\u5728\u4F4E\u8A9E\u4E2D\u88AB\u5543\u566C\u6B86\u76E1\u3002\n\u5016\u5B58\u8005\u53EA\u8A18\u5F97\u90A3\u5C0D\u767C\u5149\u7684\u96D9\u773C\uFF0C\u8207\u9ED1\u6697\u4E2D\u50B3\u4F86\u7684\u6495\u88C2\u8072\u3002"
  descriptionEn: 'No one knows what form it originally had. Some believe that darkness
    itself learned how to hunger.

    Wherever it prowls, lights are extinguished
    one by one, and courage is gnawed away by murmuring whispers.

    Survivors
    remember only a pair of glowing eyes, and the tearing sounds echoing from the
    dark.'
  descriptionJa: "\u305D\u308C\u304C\u6700\u521D\u306B\u3069\u306E\u3088\u3046\u306A\u59FF\u3060\u3063\u305F\u306E\u304B\u3001\u77E5\u308B\u8005\u306F\u3044\u306A\u3044\u3002\n\u95C7\u305D\u306E\u3082\u306E\u304C\u300C\u98E2\u3048\u300D\u3092\u899A\u3048\u305F\u306E\u3060\u3068\u8003\u3048\u308B\u8005\u3082\u3044\u308B\u3002\n\u5F7C\u304C\u5F77\u5FA8\u3046\u5730\u3067\u306F\u3001\u706F\u308A\u306F\u6B21\u3005\u3068\u6D88\u3048\u53BB\u308A\u3001\u56C1\u304D\u306E\u4E2D\u3067\u52C7\u6C17\u306F\u55B0\u3089\u3044\u5C3D\u304F\u3055\u308C\u308B\u3002\n\u751F\u5B58\u8005\u304C\u899A\u3048\u3066\u3044\u308B\u306E\u306F\u3001\u95C7\u306E\u4E2D\u3067\u5149\u308B\u4E00\u5BFE\u306E\u773C\u3068\u3001\u5F15\u304D\u88C2\u304F\u3088\u3046\u306A\u97F3\u3060\u3051\u3060\u3002"
