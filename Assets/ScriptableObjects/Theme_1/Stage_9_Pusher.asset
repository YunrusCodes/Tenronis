  m_Script: {fileID: 11500000, guid: 3fe80882f65a4ff479ef1fca5ee38a6f, type: 3}
  m_Name: Stage_9_Pusher
  m_EditorClassIdentifier: 
  stageName: "\u9006\u5370"
  stageNameEn: Inverted Sigil
  stageNameJa: "\u9006\u5370"
  stageIndex: 9
  isBossStage: 0
  description: "\u6C92\u6709\u4EBA\u77E5\u9053\u90A3\u9053\u5012\u61F8\u7684\u5370\u8A18\u8C61\u5FB5\u4EC0\u9EBC\uFF0C\u6709\u4EBA\u8A8D\u70BA\u90A3\u662F\u88AB\u985B\u5012\u7684\u6551\u8D16\u3002\n\u7576\u4ED6\u73FE\u8EAB\uFF0C\u4FE1\u4EF0\u8207\u6050\u61FC\u4E0D\u518D\u6709\u5340\u5225\uFF0C\u4E00\u5207\u7948\u79B1\u90FD\u6703\u88AB\u91CD\u65B0\u89E3\u8B80\u3002\n\u90A3\u96D9\u767C\u5149\u7684\u773C\u4E0D\u5E36\u60C5\u611F\uFF0C\u53EA\u662F\u5728\u8861\u91CF\u2014\u2014\u8AB0\u8A72\u88AB\u7559\u4E0B\uFF0C\u8AB0\u8A72\u88AB\u62B9\u9664\u3002\n\u4F38\u51FA\u7684\u96D9\u624B\u4E0D\u662F\u7D22\u6C42\uFF0C\u800C\u662F\u5728\u5BA3\u8B80\u7D50\u679C\u4E4B\u524D\uFF0C\u7D66\u4E88\u6700\u5F8C\u7684\u932F\u89BA\u3002"
  descriptionEn: "No one knows what the inverted mark means\u2014some call it inverted
    salvation.\nWhen it appears, faith and fear become one, and every prayer is rewritten.\nIts
    emotionless eyes judge who remains and who is erased.\nThe outstretched hands
    offer not mercy, but a final illusion before the verdict."
  descriptionJa: "\u9006\u3055\u306B\u523B\u307E\u308C\u305F\u305D\u306E\u5370\u304C\u4F55\u3092\u8C61\u5FB4\u3057\u3066\u3044\u308B\u306E\u304B\u3001\u8AB0\u306B\u3082\u5206\u304B\u3089\u306A\u3044\u3002\n\u305D\u308C\u306F\u300C\u985B\u5012\u3055\u308C\u305F\u6551\u6E08\u300D\u3060\u3068\u8A9E\u308B\u8005\u3082\u3044\u308B\u3002\n\u5F7C\u304C\u73FE\u308C\u305F\u77AC\u9593\u3001\u4FE1\u4EF0\u3068\u6050\u6016\u306E\u5883\u754C\u306F\u5931\u308F\u308C\u3001\u3042\u3089\u3086\u308B\u7948\u308A\u306F\u65B0\u305F\u306A\u610F\u5473\u3078\u3068\u66F8\u304D\u63DB\u3048\u3089\u308C\u308B\u3002\n\u611F\u60C5\u3092\u5BBF\u3055\u306A\u3044\u767A\u5149\u3059\u308B\u53CC\u773C\u306F\u3001\u305F\u3060\u91CF\u308B\u3060\u3051\u3060\u2015\u2015\u8AB0\u3092\u6B8B\u3057\u3001\u8AB0\u3092\u62B9\u6D88\u3059\u308B\u306E\u304B\u3092\u3002\n\u5DEE\u3057\u4F38\u3079\u3089\u308C\u305F\u4E21\u624B\u306F\u7D22\u3081\u3066\u3044\u308B\u306E\u3067\u306F\u306A\u3044\u3002\u88C1\u5B9A\u304C\u4E0B\u3055\u308C\u308B\u76F4\u524D\u306B\u4E0E\u3048\u3089\u308C\u308B\u3001\u6700\u5F8C\u306E\u932F\u899A\u306A\u306E\u3060\u3002"
