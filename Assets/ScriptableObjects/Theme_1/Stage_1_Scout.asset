  tips:
  - "\u9F4A\u5C04(\u591A\u884C\u6D88\u9664)\u8DDF\u9023\u767C(\u9023\u7E8C\u6D88\u9664)\u90FD\u80FD\u9020\u6210\u984D\u5916\u50B7\u5BB3\u3002"
  - "\u50B3\u5947\u5DE5\u7A0B\u9700\u8981\u900F\u904E\u628A\u4E00\u500B\u5DE5\u7A0B\u7684\u7B49\u7D1A\u5347\u6EFF\u7372\u5F97"
  - "\u4E0D\u540C\u6027\u8CEA\u7684\u5DE5\u7A0B\u7B49\u7D1A\u4E0A\u9650\u4E5F\u4E0D\u540C"
  - "\u4F60\u53EF\u4EE5\u4E0D\u65B7\u65CB\u8F49\u65B9\u584A\u4F86\u62C9\u5EF6\u6230\u5C40"
  - "\u53CD\u64CA\u4E5F\u7B97\u4E00\u6B21\u9023\u767C"
  - "\u4F60\u53EF\u4EE5\u4E00\u76F4\u53CD\u64CA\uFF0C\u4F46\u662F\u6230\u5834\u4E00\u5B9A\u6703\u8D85\u4E82"
  - "\u6309\u9375A\u4F7F\u7528\u5132\u5B58\u69FD\uFF0C\u5C07\u73FE\u6709\u7684\u65B9\u584A\u653E\u5165\u7A7A\u7684\u69FD\u4F4D\uFF0C\u6216\u662F\u8207\u69FD\u4F4D\u5167\u7684\u65B9\u584A\u9032\u884C\u4EA4\u63DB"
