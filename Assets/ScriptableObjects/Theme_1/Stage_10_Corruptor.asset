  stageName: "\u5922\u6E26\u738B"
  stageIndex: 10
  isBossStage: 1
  description: "\u90A3\u5DF2\u7D93\u4E0D\u662F\u5B58\u5728\uFF0C\u800C\u662F\u4E00\u5834\u7121\u6CD5\u9192\u4F86\u7684\u96C6\u9AD4\u60E1\u5922\u3002\n\u7576\u4ED6\u6D6E\u73FE\uFF0C\u73FE\u5BE6\u6703\u958B\u59CB\u5D29\u89E3\uFF0C\u6050\u61FC\u5F7C\u6B64\u7E8F\u7E5E\u3001\u589E\u6B96\uFF0C\u50CF\u6F29\u6E26\u822C\u541E\u566C\u6240\u6709\u610F\u8B58\u3002\n\u90A3\u5F35\u5F35\u958B\u5230\u4E0D\u5408\u5E38\u7406\u7684\u5DE8\u53E3\uFF0C\u4E0D\u662F\u5728\u5486\u54EE\u2014\u2014\u800C\u662F\u5728\u5632\u7B11\uFF0C\u5632\u7B11\u4EFB\u4F55\u4ECD\u8A66\u5716\u7406\u89E3\u4ED6\u7684\u5B58\u5728\u3002\n\u7121\u6578\u626D\u66F2\u7684\u5922\u5F71\u5728\u4ED6\u8EAB\u5F8C\u7FFB\u6E67\uFF0C\u6B63\u662F\u88AB\u4ED6\u541E\u566C\u5F8C\uFF0C\u518D\u4E5F\u7121\u6CD5\u9192\u4F86\u7684\u8B49\u660E\u3002"
  rewardBuffCount: 5
  maxHp: 2000
  shootInterval: 1
