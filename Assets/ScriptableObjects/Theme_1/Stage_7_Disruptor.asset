  m_Script: {fileID: 11500000, guid: 3fe80882f65a4ff479ef1fca5ee38a6f, type: 3}
  m_Name: Stage_7_Disruptor
  m_EditorClassIdentifier: 
  stageName: "\u7D22\u547D\u8005"
  stageNameEn: Reaper of the Last Breath
  stageNameJa: "\u7D22\u547D\u8005"
  stageIndex: 7
  isBossStage: 0
  description: "\u90A3\u5C0D\u96D9\u773C\uFF0C\u662F\u6B7B\u4EA1\u7559\u4E0B\u7684\u6B98\u5149\u3002\n\u7576\u4ED6\u9760\u8FD1\uFF0C\u56DB\u5468\u6703\u9677\u5165\u7570\u6A23\u7684\u5BC2\u975C\uFF0C\u5F77\u5F7F\u9023\u6050\u61FC\u90FD\u88AB\u5F37\u884C\u58D3\u4F4E\u4E86\u8072\u97F3\u3002\n\u4ED6\u4E0D\u6025\u8457\u64B2\u6BBA\uFF0C\u53EA\u662F\u4F38\u51FA\u90A3\u626D\u66F2\u7684\u624B\uFF0C\u7DE9\u6162\u5730\u7D22\u53D6\u6700\u5F8C\u7684\u53CD\u6297\u3002\n\u51E1\u88AB\u4ED6\u89F8\u53CA\u8005\uFF0C\u751F\u547D\u6703\u50CF\u71C8\u706B\u822C\u4E00\u7BC0\u4E00\u7BC0\u7184\u6EC5\uFF0C\u53EA\u5269\u7A7A\u6BBC\u5728\u539F\u5730\u7AD9\u7ACB\u3002"
  descriptionEn: "Those twin eyes are the afterglow of death itself.\nAs it approaches,
    an unnatural silence falls, as if even fear has been muted.\nIt does not strike
    in haste\u2014its twisted hand slowly drains the last resistance.\nThose it touches
    fade like dying flames, leaving only empty shells behind."
  descriptionJa: "\u305D\u306E\u53CC\u773C\u306F\u3001\u6B7B\u304C\u6B8B\u3057\u305F\u6B8B\u5149\u3060\u3002\n\u5F7C\u304C\u8FD1\u3065\u304F\u3068\u3001\u5468\u56F2\u306F\u7570\u69D8\u306A\u9759\u5BC2\u306B\u5305\u307E\u308C\u3001\u6050\u6016\u3055\u3048\u3082\u58F0\u3092\u62BC\u3057\u6BBA\u3057\u305F\u304B\u306E\u3088\u3046\u306B\u306A\u308B\u3002\n\u5F7C\u306F\u6025\u3044\u3067\u8972\u3044\u304B\u304B\u308B\u3053\u3068\u306F\u306A\u3044\u3002\u305F\u3060\u6B6A\u3093\u3060\u624B\u3092\u5DEE\u3057\u4F38\u3079\u3001\u6700\u5F8C\u306E\u62B5\u6297\u3092\u3086\u3063\u304F\u308A\u3068\u596A\u3044\u53D6\u308B\u3002\n\u89E6\u308C\u3089\u308C\u305F\u8005\u306E\u547D\u306F\u706F\u706B\u306E\u3088\u3046\u306B\u4E00\u7BC0\u305A\u3064\u6D88\u3048\u53BB\u308A\u3001\u305D\u306E\u5834\u306B\u306F\u7A7A\u306E\u6BBB\u3060\u3051\u304C\u7ACB\u3061\u5C3D\u304F\u3059\u3002"
