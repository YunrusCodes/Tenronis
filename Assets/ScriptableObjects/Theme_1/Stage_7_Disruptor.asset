  m_Name: Stage_7_Disruptor
  m_EditorClassIdentifier: 
  stageName: "\u7D22\u547D\u8005"
  stageNameEn: Reaper of the Last Breath
  stageNameJa: "\u7D22\u547D\u8005"
  stageIndex: 7
  isBossStage: 0
  description: "\u90A3\u7A2E\u5BC2\u975C\u4E0D\u662F\u5E73\u975C\uFF0C\u662F\u4E00\u7A2E\u58D3\u529B\uFF0C\u628A\u6240\u6709\u8072\u97F3\u90FD\u58D3\u9032\u4E86\u76AE\u819A\u88E1\u3002\n\u4ED6\u4E0D\u6025\u3002\n\u90A3\u96BB\u624B\u4F38\u51FA\u4F86\uFF0C\u4E0D\u662F\u8981\u6293\u4F60\u2014\u2014\u662F\u5728\u78BA\u8A8D\u4F60\u9084\u5728\u90A3\u88E1\u3002\n\u88AB\u4ED6\u89F8\u78B0\u904E\u7684\uFF0C\u6C92\u6709\u6B7B\u3002\u4ED6\u5011\u53EA\u662F\u505C\u6B62\u4E86\u5C6C\u65BC\u81EA\u5DF1\u7684\u79FB\u52D5\u65B9\u5F0F\u3002"
  descriptionEn: "That silence is not peace. It is pressure\u2014pushing every sound back into your skin.\nIt is not in a hurry.\nThat hand reaching out is not reaching for you\u2014it is confirming you are still there.\nThose it touches do not die. They simply stop moving in the way that was theirs."
  descriptionJa: "\u3042\u306E\u9759\u5BC2\u306F\u7A4F\u3084\u304B\u3055\u3067\u306F\u306A\u3044\u3002\u5727\u529B\u3060\u2014\u2014\u3042\u3089\u3086\u308B\u97F3\u3092\u76AE\u819A\u306E\u5185\u5074\u3078\u62BC\u3057\u8FBC\u3080\u3002\n\u6025\u3044\u3067\u3044\u306A\u3044\u3002\n\u4F38\u3070\u3055\u308C\u305F\u305D\u306E\u624B\u306F\u3042\u306A\u305F\u3092\u63B4\u3082\u3046\u3068\u3057\u3066\u3044\u308B\u306E\u3067\u306F\u306A\u3044\u2014\u2014\u3042\u306A\u305F\u304C\u307E\u3060\u305D\u3053\u306B\u3044\u308B\u3053\u3068\u3092\u78BA\u8A8D\u3057\u3066\u3044\u308B\u306E\u3060\u3002\n\u89E6\u308C\u3089\u308C\u305F\u8005\u306F\u6B7B\u306A\u306A\u3044\u3002\u305F\u3060\u3001\u81EA\u5206\u306E\u3082\u306E\u3060\u3063\u305F\u52D5\u304D\u65B9\u3092\u3084\u3081\u308B\u3060\u3051\u3060\u3002"
