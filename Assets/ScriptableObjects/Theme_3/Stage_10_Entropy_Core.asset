  m_Name: Stage_10_Entropy_Core
  m_EditorClassIdentifier: 
  stageName: "\u6028\u8840\u738B"
  stageNameEn: Bloodgrudge King
  stageNameJa: "\u6028\u8840\u738B"
  stageIndex: 10
  isBossStage: 1
  description: "\u7576\u6028\u8840\u738B\u964D\u81E8\uFF0C\u7A7A\u9593\u6703\u958B\u59CB\u6EF2\u8840\u3002\n\u90A3\u4E0D\u662F\u50B7\u53E3\uFF0C\u800C\u662F\u4E16\u754C\u672C\u8EAB\u88AB\u8FEB\u56DE\u61B6\u8D77\u66FE\u7D93\u6D41\u904E\u7684\u6240\u6709\u8840\u3002\n\u61F8\u6D6E\u65BC\u4ED6\u5468\u8EAB\u7684\u8D64\u8272\u5149\u6838\uFF0C\u5982\u540C\u5C1A\u672A\u51B7\u537B\u7684\u6028\u5FF5\u7D50\u6676\uFF0C\u8108\u52D5\u6642\u4FBF\u6703\u8A95\u751F\u65B0\u7684\u8840\u53E3\u3002\n\u6BCF\u4E00\u6B21\u5F35\u5408\uFF0C\u90FD\u662F\u4E00\u6B21\u96C6\u9AD4\u7684\u5C16\u562F\u2014\u2014\n\u4E0D\u662F\u70BA\u4E86\u5A01\u5687\uFF0C\u800C\u662F\u70BA\u4E86\u5BA3\u6CC4\u6C38\u9060\u7121\u6CD5\u5E73\u606F\u7684\u4EC7\u6068\u3002"
  descriptionEn: "When the Bloodgrudge King descends, space itself begins to bleed\u2014not
    as wounds, but as memory.\nCrimson light-cores pulse around it, birthing bleeding
    maws with each beat.\nEvery opening is a collective shriek, venting a hatred
    that can never be silenced."
  descriptionJa: "\u6028\u8840\u738B\u304C\u964D\u81E8\u3059\u308B\u3068\u3001\u7A7A\u9593\u306F\u8840\u3092\u6EF2\u307E\u305B\u59CB\u3081\u308B\u3002\n\u305D\u308C\u306F\u50B7\u3067\u306F\u306A\u304F\u3001\u4E16\u754C\u304C\u6D41\u3057\u305F\u8840\u306E\u8A18\u61B6\u3060\u3002\n\u5468\u56F2\u306B\u6D6E\u304B\u3076\u8D64\u304D\u5149\u6838\u306F\u3001\u51B7\u3048\u304D\u3089\u306C\u6028\u5FF5\u306E\u7D50\u6676\u3067\u3042\u308A\u3001\n\u8108\u52D5\u306E\u305F\u3073\u8840\u306E\u53E3\u3092\u751F\u307F\u3001\u96C6\u56E3\u306E\u5C16\u53EB\u3092\u653E\u3064\u3002\n\u305D\u308C\u306F\u5A01\u5687\u3067\u306F\u306A\u3044\u2015\u2015\u93AE\u307E\u3089\u306C\u618E\u60AA\u306E\u767A\u9732\u306A\u306E\u3060\u3002"
