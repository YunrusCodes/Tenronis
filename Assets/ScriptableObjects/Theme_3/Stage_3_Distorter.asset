  enemyIcon: {fileID: -4624321620405553735, guid: 3b5612c95848ada4b8ed4e477365315b, type: 3}
  themeColor: {r: 1, g: 0, b: 0, a: 1}
  tips:
  - "\u4E0D\u8981\u7528\u8150\u5316\u7206\u70B8\u7684\u65B9\u584A\u53BB\u53CD\u64CA\u7BC4\u570D\u50B7\u5BB3\uFF0C\u5426\u5247\u5F8C\u679C\u81EA\u8CA0"
  - "\u8ACB\u8B39\u614E\u61C9\u5C0D\u7BC4\u570D\u50B7\u5BB3\u8207\u7206\u70B8\u65B9\u584A\u7684\u7D44\u5408"
  - "\u8ACB\u8A18\u5F97\uFF0C\u9019\u88E1\u662F\u57F7\u70AE\u4EBA\u8207\u602A\u7269\u4E4B\u9593\u7684\u6230\u5834\uFF0C\u4E0D\u662F\u76CA\u667A\u904A\u6232"
  - "\u7BC4\u570D\u5B50\u5F48\u6703\u76F4\u63A5\u70B8\u6389\u6574\u500B\u4E5D\u5BAE\u683C\u7BC4\u570D\u7684\u65B9\u584A"
  - "\u9F4A\u5C04(\u591A\u884C\u6D88\u9664)\u8DDF\u9023\u767C(\u9023\u7E8C\u6D88\u9664)\u90FD\u80FD\u9020\u6210\u984D\u5916\u50B7\u5BB3\u3002"
  - "\u5FC5\u8981\u7684\u6642\u5019\u5C31\u628A\u65B9\u584A\u5806\u7206\u5427\uFF0C\u6E05\u6383\u6230\u5834\uFF0C\u9806\u4FBF\u7D66\u90A3\u602A\u7269\u4F86\u767C\u5927\u7684"
  - "\u4F60\u53EF\u4EE5\u4E0D\u65B7\u65CB\u8F49\u65B9\u584A\u4F86\u62C9\u5EF6\u6230\u5C40"
  - "\u53CD\u64CA\u4E5F\u7B97\u4E00\u6B21\u9023\u767C"
  - "\u80FD\u4F7F\u7528\u6E6E\u6EC5\u7684\u8A71\u7528\u4F86\u9583\u907F\u8150\u5316\u65B9\u584A\u5427"
  - "\u8B93\u9019\u500B\u653B\u64CA\u6253\u5230\u4F60\u7684\u65B9\u584A\u6703\u5B8C\u86CB?\u90A3\u7528\u8655\u6C7A\u6514\u622A\u5427"
  - "\u978F\u56FA\u9632\u79A6\u770B\u4F3C\u4E0D\u8D77\u773C\uFF0C\u5176\u5BE6\u6703\u5F15\u8D77\u8CEA\u8B8A\uFF0C\u7528\u904E\u7684\u90FD\u8AAA\u8B9A"
  - "\u52A0\u500D\u706B\u529B\u53EF\u662F\u7528\u7D14\u7CB9\u7684\u91CF\u8B8A\u5F15\u8D77\u8CEA\u8B8A\uFF0C\u7562\u7ADF\u6050\u61FC\u6E90\u65BC\u706B\u529B\u4E0D\u8DB3"
  - "\u6210\u529F\u9020\u51FA\u4FEE\u88DC\u90A3\u4F60\u53EF\u5E78\u904B\u4E86\uFF0C\u5B83\u53EF\u4EE5\u8B93\u4F60\u72E0\u72E0\u5236\u88C1\u602A\u7269"
  - "\u6230\u9B25\u958B\u59CB\u6642\u90FD\u6703\u56DE\u5FA9cp"
  - "\u6E6E\u6EC5\u3001\u8655\u6C7A\u3001\u4FEE\u88DC\u53EF\u80FD\u8B93\u4F60\u7121\u6CD5\u511F\u9084\u65B9\u584A\u6EA2\u51FA\u7684\u4EE3\u50F9\uFF0C\u9019\u6642\u5C31\u6703\u8B8A\u5F97\u4E0D\u5835\u4E00\u64CA"
  - "\u6309\u9375A\u4F7F\u7528\u5132\u5B58\u69FD\uFF0C\u5C07\u73FE\u6709\u7684\u65B9\u584A\u653E\u5165\u7A7A\u7684\u69FD\u4F4D\uFF0C\u6216\u662F\u8207\u69FD\u4F4D\u5167\u7684\u65B9\u584A\u9032\u884C\u4EA4\u63DB"
  - "\u7A7A\u9593\u64F4\u5145\u80FD\u89E3\u9396\u6309\u9375S\u3001D\u3001F\u5C0D\u61C9\u7684\u5132\u5B58\u69FD"
  - "\u6490\u8457\u5427\uFF0C\u4E5F\u8A31\u73FE\u5728\u7684\u5145\u80FD\u4E4B\u5F8C\u624D\u6703\u7528\u5230"
  - "\u4F60\u53EF\u4EE5\u4E00\u76F4\u53CD\u64CA\uFF0C\u4F46\u662F\u6230\u5834\u4E00\u5B9A\u6703\u8D85\u4E82"
  - "\u6EA2\u51FA\u65B9\u584A\u5F8C\u5728\u4E7E\u6DE8\u7684\u6230\u5834\u91CD\u6574\u614B\u52E2\u5427!"
  - "\u6D88\u5230\u865B\u7121\u65B9\u584A\u6703\u8B93\u4F60\u76F4\u63A5\u7121\u6CD5\u653B\u64CA"
