  stageName: "\u7344\u568E"
  stageIndex: 5
  isBossStage: 1
  description: "\u7576\u4ED6\u767C\u51FA\u568E\u53EB\uFF0C\u8072\u97F3\u4E26\u4E0D\u53EA\u662F\u9707\u52D5\u7A7A\u6C23\uFF0C\u800C\u662F\u76F4\u63A5\u6495\u626F\u610F\u8B58\uFF0C\u8B93\u8A18\u61B6\u8207\u7406\u667A\u4E00\u540C\u5D29\u6563\u3002\n\u90A3\u5C0D\u71C3\u767D\u7684\u96D9\u773C\u4E0D\u65B7\u6EF2\u843D\u5149\u75D5\uFF0C\u50CF\u662F\u88AB\u5F37\u884C\u64E0\u51FA\u7684\u75DB\u82E6\uFF0C\u6CBF\u8457\u9ED1\u5F71\u6EF4\u843D\u4E0D\u6B62\u3002\n\u7FFB\u6E67\u7684\u9577\u5F71\u5728\u4ED6\u5468\u570D\u72C2\u4E82\u821E\u52D5\uFF0C\u5F77\u5F7F\u6BCF\u4E00\u9053\u90FD\u662F\u88AB\u568E\u8072\u559A\u9192\u3001\u518D\u4E5F\u7121\u6CD5\u5B89\u606F\u7684\u6B98\u9B42\u3002"
  rewardBuffCount: 2
  maxHp: 600
