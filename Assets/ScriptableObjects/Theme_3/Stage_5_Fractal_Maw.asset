  m_Name: Stage_5_Fractal_Maw
  m_EditorClassIdentifier: 
  stageName: "\u7344\u568E"
  stageNameEn: Infernal Howl
  stageNameJa: "\u7344\u568E"
  stageIndex: 5
  isBossStage: 1
  description: "\u7576\u4ED6\u767C\u51FA\u568E\u53EB\uFF0C\u8072\u97F3\u4E26\u4E0D\u53EA\u662F\u9707\u52D5\u7A7A\u6C23\uFF0C\u800C\u662F\u76F4\u63A5\u6495\u626F\u610F\u8B58\uFF0C\u8B93\u8A18\u61B6\u8207\u7406\u667A\u4E00\u540C\u5D29\u6563\u3002\n\u90A3\u5C0D\u71C3\u767D\u7684\u96D9\u773C\u4E0D\u65B7\u6EF2\u843D\u5149\u75D5\uFF0C\u50CF\u662F\u88AB\u5F37\u884C\u64E0\u51FA\u7684\u75DB\u82E6\uFF0C\u6CBF\u8457\u9ED1\u5F71\u6EF4\u843D\u4E0D\u6B62\u3002\n\u7FFB\u6E67\u7684\u9577\u5F71\u5728\u4ED6\u5468\u570D\u72C2\u4E82\u821E\u52D5\uFF0C\u5F77\u5F7F\u6BCF\u4E00\u9053\u90FD\u662F\u88AB\u568E\u8072\u559A\u9192\u3001\u518D\u4E5F\u7121\u6CD5\u5B89\u606F\u7684\u6B98\u9B42\u3002"
  descriptionEn: 'When it howls, the sound tears at consciousness, shattering memory
    and reason.

    Its burning white eyes bleed light like forced pain, dripping
    along its shadow.

    The writhing shadows around it are awakened remnants,
    never allowed to rest again.'
  descriptionJa: "\u5F7C\u304C\u5486\u54EE\u3059\u308B\u3068\u3001\u305D\u306E\u97F3\u306F\u7A7A\u6C17\u3092\u9707\u308F\u305B\u308B\u3060\u3051\u3067\u306F\u306A\u3044\u3002\n\u610F\u8B58\u305D\u306E\u3082\u306E\u3092\u5F15\u304D\u88C2\u304D\u3001\u8A18\u61B6\u3068\u7406\u6027\u3092\u540C\u6642\u306B\u5D29\u58CA\u3055\u305B\u308B\u3002\n\u71C3\u3048\u308B\u3088\u3046\u306B\u767D\u3044\u305D\u306E\u53CC\u773C\u304B\u3089\u306F\u5149\u306E\u75D5\u304C\u6EA2\u308C\u843D\u3061\u3001\n\u7121\u7406\u3084\u308A\u7D5E\u308A\u51FA\u3055\u308C\u305F\u75DB\u82E6\u306E\u3088\u3046\u306B\u3001\u9ED2\u5F71\u3092\u4F1D\u3063\u3066\u6B62\u307E\u308B\u3053\u3068\u306A\u304F\u6EF4\u308A\u7D9A\u3051\u308B\u3002\n\u5468\u56F2\u3067\u7FFB\u308A\u72C2\u3046\u9577\u3044\u5F71\u306F\u3001\u568E\u58F0\u306B\u3088\u3063\u3066\u547C\u3073\u899A\u307E\u3055\u308C\u3001\n\u4E8C\u5EA6\u3068\u5B89\u606F\u3092\u8A31\u3055\u308C\u306C\u6B8B\u9B42\u3067\u3042\u308B\u304B\u306E\u3088\u3046\u3060\u3002"
