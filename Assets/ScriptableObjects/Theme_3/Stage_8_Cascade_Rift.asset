  m_Name: Stage_8_Cascade_Rift
  m_EditorClassIdentifier: 
  stageName: "\u8840\u5DEB"
  stageNameEn: Blood Hexer
  stageNameJa: "\u8840\u5DEB"
  stageIndex: 8
  isBossStage: 0
  description: "\u6CE8\u610F\u7259\u7E2B\u6EF4\u7684\u662F\u4EC0\u9EBC\u2014\u2014\u662F\u8840\uFF0C\u4E0D\u662F\u5149\u3002\n\u9019\u662F\u9019\u4E00\u95DC\u7B2C\u4E00\u500B\u771F\u6B63\u5728\u6EF4\u8840\u7684\u3002\n\u5B83\u7684\u624B\u653E\u5728\u524D\u65B9\uFF0C\u4E0D\u662F\u8981\u6293\uFF0C\u662F\u5728\u7B49\u3002\n\u90A3\u5C0D\u7329\u7D05\u7684\u773C\u775B\u4E0D\u5728\u770B\u4F60\u7684\u8EAB\u9AD4\u2014\u2014\u5728\u8A08\u7B97\u3002\n\u6050\u61FC\u3001\u75DB\u695A\u8207\u72A7\u7272\uFF0C\u54EA\u4E00\u7A2E\u66F4\u503C\u5F97\u6536\u5272\u3002\n\u5F9E\u5B83\u8EAB\u4E0A\u6EF4\u843D\u7684\u4E0D\u662F\u9BAE\u8840\uFF0C\u800C\u662F\u88AB\u596A\u8D70\u7684\u8A18\u61B6\u8207\u8A93\u8A00\uFF0C\u6B63\u5728\u6162\u6162\u84B8\u767C\u6210\u8A5B\u5492\u3002"
  descriptionEn: "Notice what is dripping from between those teeth—it is blood, not light.\nThis is the first one in this sequence that is truly bleeding.\nThose hands rest out front, not reaching to seize—waiting.\nThose crimson eyes are not looking at your body. They are calculating.\nFear, pain, sacrifice—which is worth harvesting more.\nWhat drips from it is not fresh blood. It is stolen memory and broken vows, slowly evaporating into curse."
  descriptionJa: "\u3042\u306E\u6B6F\u306E\u9593\u304B\u3089\u6EF4\u308A\u843D\u3061\u3066\u3044\u308B\u3082\u306E\u306B\u6CE8\u76EE\u3057\u308D\u2014\u2014\u5149\u3067\u306F\u306A\u304F\u3001\u8840\u3060\u3002\n\u3053\u306E\u95A2\u9580\u3067\u3001\u672C\u5F53\u306B\u8840\u3092\u6D41\u3057\u3066\u3044\u308B\u6700\u521D\u306E\u5B58\u5728\u3060\u3002\n\u4E21\u624B\u306F\u524D\u306B\u7F6E\u304B\u308C\u3066\u3044\u308B\u3002\u63B4\u3082\u3046\u3068\u3057\u3066\u3044\u308B\u306E\u3067\u306F\u306A\u304F\u3001\u5F85\u3063\u3066\u3044\u308B\u3002\n\u7329\u7D05\u306E\u53CC\u773C\u306F\u3042\u306A\u305F\u306E\u4F53\u3092\u898B\u3066\u3044\u306A\u3044\u3002\u8A08\u7B97\u3057\u3066\u3044\u308B\u3002\n\u6050\u6016\u3001\u82E6\u75DB\u3001\u72A0\u7272\u2014\u2014\u3069\u308C\u304C\u3088\u308A\u53CE\u7A6B\u306B\u5024\u3059\u308B\u304B\u3092\u3002\n\u305D\u3053\u304B\u3089\u6EF4\u308B\u306E\u306F\u65B0\u9BAE\u306A\u8840\u3067\u306F\u306A\u3044\u3002\u596A\u308F\u308C\u305F\u8A18\u61B6\u3068\u8A93\u3044\u304C\u3001\u3086\u3063\u304F\u308A\u3068\u546A\u3044\u3078\u3068\u84B8\u767A\u3057\u3066\u3044\u304F\u3002"
