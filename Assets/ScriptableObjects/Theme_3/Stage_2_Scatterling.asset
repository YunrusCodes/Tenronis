  m_Name: Stage_2_Scatterling
  m_EditorClassIdentifier: 
  stageName: "\u7344\u5F71"
  stageNameEn: Infernal Shade
  stageNameJa: "\u7344\u5F71"
  stageIndex: 2
  isBossStage: 0
  description: "\u5B83\u6BD4\u7B2C\u4E00\u500B\u66F4\u6709\u5BE6\u9AD4\u2014\u2014\u817F\uFF0C\u722A\uFF0C\u9023\u7E8C\u7684\u4E00\u6574\u6392\u9F52\u3002\n\u90A3\u500B\u7B11\u5BB9\u592A\u5E73\u975C\u4E86\u3002\n\u4E0D\u662F\u8AAA\u5B83\u4E0D\u5371\u96AA\u2014\u2014\u662F\u8AAA\u5B83\u5C0D\u7D50\u679C\u592A\u6709\u628A\u63E1\u4E86\uFF0C\u4E0D\u9700\u8981\u7528\u8868\u60C5\u4F86\u5F37\u8ABF\u3002\n\u5B83\u662F\u5F9E\u7149\u7344\u4E2D\u8A95\u751F\uFF1F\u9084\u662F\u7149\u7344\u672C\u8EAB\u6295\u5C04\u5230\u73FE\u5BE6\u7684\u5F71\u5B50\uFF1F\n\u90A3\u4E9B\u817F\u4E0D\u662F\u5728\u8FFD\u4F60\u3002\n\u662F\u78BA\u4FE1\u9577\u51FA\u4E86\u8173\u3002"
  descriptionEn: "This one is more solid than the first—legs, claws, a continuous unbroken row of teeth.\nThat smile is too calm.\nNot that it is harmless—it is that it is too certain of the outcome to bother emphasizing it.\nWas it born from the inferno, or is it the inferno’s own shadow cast onto reality?\nThose legs are not chasing you.\nThat is certainty, grown into limbs."
  descriptionJa: "\u6700\u521D\u306E\u3082\u306E\u3088\u308A\u5B9F\u4F53\u304C\u3042\u308B\u2014\u2014\u811A\u3001\u722A\u3001\u9014\u5207\u308C\u306E\u306A\u3044\u4E00\u5217\u306E\u6B6F\u3002\n\u3042\u306E\u7B11\u307F\u306F\u9759\u304B\u3059\u304E\u308B\u3002\n\u5371\u967A\u3067\u306F\u306A\u3044\u3068\u3044\u3046\u3053\u3068\u3067\u306F\u306A\u3044\u2014\u2014\u7D50\u679C\u306B\u78BA\u4FE1\u304C\u3042\u308A\u3059\u304E\u3066\u3001\u8868\u60C5\u3067\u5F37\u8ABF\u3059\u308B\u5FC5\u8981\u304C\u306A\u3044\u306E\u3060\u3002\n\u7149\u7344\u304B\u3089\u751F\u307E\u308C\u305F\u306E\u304B\u3001\u305D\u308C\u3068\u3082\u7149\u7344\u305D\u306E\u3082\u306E\u304C\u73FE\u5B9F\u306B\u6295\u3058\u305F\u5F71\u306A\u306E\u304B\u3002\n\u3042\u306E\u811A\u306F\u3042\u306A\u305F\u3092\u8FFD\u3063\u3066\u3044\u306A\u3044\u3002\n\u78BA\u4FE1\u304C\u3001\u811A\u3092\u751F\u3084\u3057\u305F\u306E\u3060\u3002"
