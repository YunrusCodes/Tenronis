  m_Name: Stage_4_Instable
  m_EditorClassIdentifier: 
  stageName: "\u7344\u6DF5\u4F7F\u8005"
  stageNameEn: Herald of the Infernal Abyss
  stageNameJa: "\u7344\u6DF5\u4F7F\u8005"
  stageIndex: 4
  isBossStage: 0
  description: "\u7149\u7344\u8207\u6DF1\u6DF5\u4E4B\u9593\u7684\u901A\u9053\u3002\u7576\u4ED6\u73FE\u8EAB\uFF0C\u8840\u7D05\u7684\u7A7A\u6C23\u6703\u958B\u59CB\u7FFB\u6E67\uFF0C\u5F77\u5F7F\u6574\u500B\u4E16\u754C\u6B63\u88AB\u62D6\u5411\u66F4\u6DF1\u4E00\u5C64\u7684\u5730\u7344\u3002\n\u90A3\u5C0D\u71C3\u767D\u7684\u96D9\u773C\u4E0D\u5E36\u72C2\u6012\uFF0C\u53EA\u6709\u51B7\u975C\u7684\u78BA\u4FE1\u2014\u2014\u78BA\u4FE1\u4F60\u5DF2\u7D93\u7AD9\u5728\u4E0D\u53EF\u56DE\u982D\u7684\u4F4D\u7F6E\u3002\n\u5F35\u88C2\u5230\u4E0D\u81EA\u7136\u7684\u7259\u53E3\u4E0D\u662F\u5486\u54EE\uFF0C\u800C\u662F\u5728\u5BA3\u544A\uFF0C\u4F7F\u8005\u5DF2\u81F3\uFF0C\u7D50\u5C40\u5DF2\u5B9A\u3002\u4ED6\u63EE\u52D5\u7684\u5229\u722A\u5982\u540C\u6DF1\u6DF5\u7684\u5370\u7AE0\uFF0C\u6BCF\u4E00\u6B21\u903C\u8FD1\uFF0C\u90FD\u662F\u5C0D\u9748\u9B42\u7684\u6B63\u5F0F\u6536\u5272\u3002"
  descriptionEn: "A passage between inferno and abyss.\nWhen it appears, blood-red
    air churns as the world is dragged toward deeper hell.\nIts burning white eyes
    hold only certainty\u2014you have crossed the point of no return.\nThe torn maw
    proclaims the end, each advancing claw sealing the soul\u2019s harvest."
  descriptionJa: "\u7149\u7344\u3068\u6DF1\u6DF5\u3092\u7E4B\u3050\u901A\u8DEF\u3002\n\u5F7C\u304C\u73FE\u308C\u308B\u3068\u3001\u8840\u306E\u3088\u3046\u306B\u8D64\u3044\u7A7A\u6C17\u304C\u6E26\u3092\u5DFB\u304D\u3001\u4E16\u754C\u305D\u306E\u3082\u306E\u304C\u3001\u3055\u3089\u306B\u6DF1\u3044\u5730\u7344\u3078\u5F15\u304D\u305A\u308A\u8FBC\u307E\u308C\u3066\u3044\u304F\u304B\u306E\u3088\u3046\u3060\u3002\n\u71C3\u3048\u308B\u3088\u3046\u306B\u767D\u3044\u53CC\u773C\u306B\u72C2\u6012\u306F\u306A\u3044\u3002\n\u3042\u308B\u306E\u306F\u305F\u3060\u3001\u3059\u3067\u306B\u5F15\u304D\u8FD4\u305B\u306A\u3044\u5834\u6240\u306B\u7ACB\u3063\u3066\u3044\u308B\u3068\u3044\u3046\u51B7\u9759\u306A\u78BA\u4FE1\u3060\u3051\u3060\u3002\n\u4E0D\u81EA\u7136\u306A\u307B\u3069\u88C2\u3051\u305F\u7259\u306E\u53E3\u306F\u5486\u54EE\u3067\u306F\u306A\u3044\u2015\u2015\n\u305D\u308C\u306F\u5BA3\u544A\u3060\u3002\u4F7F\u8005\u306F\u5230\u6765\u3057\u3001\u7D50\u672B\u306F\u3059\u3067\u306B\u5B9A\u307E\u3063\u305F\u3002\n\u632F\u308B\u308F\u308C\u308B\u5229\u722A\u306F\u6DF1\u6DF5\u306E\u523B\u5370\u306E\u3054\u3068\u304F\u3001\n\u305D\u306E\u4E00\u6B69\u4E00\u6B69\u304C\u3001\u9B42\u3092\u6B63\u5F0F\u306B\u53CE\u7A6B\u3057\u3066\u3044\u304F\u3002"
