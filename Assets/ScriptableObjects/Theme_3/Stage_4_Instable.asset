  m_Name: Stage_4_Instable
  m_EditorClassIdentifier: 
  stageName: "\u7344\u6DF5\u4F7F\u8005"
  stageNameEn: Herald of the Infernal Abyss
  stageNameJa: "\u7344\u6DF5\u4F7F\u8005"
  stageIndex: 4
  isBossStage: 0
  description: "\u5B83\u7684\u722A\u4F38\u5411\u4F60\uFF0C\u4F46\u4E0D\u662F\u8981\u6293\u4F4F\u4F60\u3002\n\u662F\u5728\u84CB\u7AE0\u3002\n\u9AB7\u9ACF\u7684\u81C9\u6C92\u6709\u8868\u60C5\u2014\u2014\u90A3\u5DF2\u7D93\u4E0D\u9700\u8981\u4E86\u3002\n\u5B83\u662F\u7149\u7344\u8207\u6DF1\u6DF5\u4E4B\u9593\u7684\u901A\u9053\u3002\u4F7F\u8005\u5230\u4E86\uFF0C\u610F\u5473\u8457\u4F60\u5DF2\u7D93\u7AD9\u5728\u4E0D\u53EF\u56DE\u982D\u7684\u4F4D\u7F6E\u4E86\u3002\n\u90A3\u526F\u89D2\u4E0D\u662F\u6B66\u5668\uFF0C\u662F\u982D\u929C\u3002\n\u7D50\u5C40\u5DF2\u5B9A\uFF0C\u9019\u6B21\u4F86\u53EA\u662F\u544A\u77E5\u3002"
  descriptionEn: "Those claws reach toward you, but not to seize.\nTo stamp.\nThe skull’s face holds no expression—it no longer needs one.\nIt is the passage between inferno and abyss. When the herald arrives, it means you are already standing at the point of no return.\nThose horns are not weapons. They are a title.\nThe outcome is decided. This visit is only notification."
  descriptionJa: "\u3042\u306E\u722A\u304C\u3042\u306A\u305F\u3078\u5411\u304B\u3063\u3066\u4F38\u3073\u3066\u3044\u308B\u3002\u3060\u304C\u63B4\u3080\u305F\u3081\u3067\u306F\u306A\u3044\u3002\n\u523B\u5370\u3059\u308B\u305F\u3081\u3060\u3002\n\u9AB8\u9AA8\u306E\u9854\u306B\u8868\u60C5\u306F\u306A\u3044\u2014\u2014\u3082\u306F\u3084\u305D\u308C\u306F\u5FC5\u8981\u306A\u3044\u3002\n\u305D\u308C\u306F\u7149\u7344\u3068\u6DF1\u6DF5\u306E\u9593\u306E\u901A\u8DEF\u3060\u3002\u4F7F\u8005\u304C\u6765\u305F\u3068\u3044\u3046\u3053\u3068\u306F\u3001\u3042\u306A\u305F\u306F\u3059\u3067\u306B\u5F15\u304D\u8FD4\u305B\u306A\u3044\u5834\u6240\u306B\u7ACB\u3063\u3066\u3044\u308B\u3068\u3044\u3046\u3053\u3068\u3060\u3002\n\u3042\u306E\u89D2\u306F\u6B66\u5668\u3067\u306F\u306A\u3044\u3002\u80A9\u66F8\u304D\u3060\u3002\n\u7D50\u672B\u306F\u6C7A\u307E\u3063\u305F\u3002\u3053\u306E\u8A2A\u554F\u306F\u305F\u3060\u306E\u901A\u544A\u3060\u3002"
