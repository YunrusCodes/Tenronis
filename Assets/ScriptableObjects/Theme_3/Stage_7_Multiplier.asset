  m_Name: Stage_7_Multiplier
  m_EditorClassIdentifier: 
  stageName: "\u98DF\u9B3C\u87F2"
  stageNameEn: Grudge-Eater Larva
  stageNameJa: "\u98DF\u9B3C\u87F2"
  stageIndex: 7
  isBossStage: 0
  description: "\u5B83\u4EE5\u5C16\u53EB\u822C\u5F35\u958B\u7684\u53E3\u5B58\u5728\uFF0C\u7D30\u9577\u7684\u9F52\u5411\u5167\u5F4E\u66F2\uFF0C\u53EA\u70BA\u9632\u6B62\u7375\u7269\u9003\u96E2\u3002\n\u982D\u90E8\u5468\u570D\u61F8\u6D6E\u8457\u6578\u9846\u767C\u5149\u7684\u773C\u56CA\uFF0C\u50CF\u8A98\u990C\uFF0C\u53C8\u50CF\u76E3\u8996\u5668\uFF0C\u6EF4\u843D\u9ECF\u7A20\u5149\u6DB2\u3002\n\u5B83\u5011\u4E26\u975E\u611F\u77E5\u4E16\u754C\uFF0C\u800C\u662F\u6A19\u8A18\u7375\u7269\u7684\u4F4D\u7F6E\u3002\n\u98DF\u9B3C\u87F2\u4E0D\u541E\u566C\u8089\u9AD4\uFF0C\u5B83\u5543\u98DF\u7684\u662F\u6B98\u7559\u7684\u6028\u3001\u6068\u8207\u6050\u61FC\u3002\n\u88AB\u5B83\u76EF\u4E0A\u7684\u5B58\u5728\uFF0C\u6703\u5148\u88AB\u5403\u7A7A\uFF0C\u518D\u88AB\u7559\u4E0B\u3002"
  descriptionEn: "It exists as a screaming maw, its inward-curving teeth trapping
    prey.\nGlowing eye-sacs drift around it, not to see, but to mark.\nThe Grudge-Eater
    feeds on resentment, hatred, and fear\u2014\nhollowing its targets from within,
    then leaving them behind."
  descriptionJa: "\u305D\u308C\u306F\u3001\u60B2\u9CF4\u306E\u3088\u3046\u306B\u958B\u3044\u305F\u53E3\u3068\u3057\u3066\u5B58\u5728\u3059\u308B\u3002\n\u5185\u5074\u306B\u6E7E\u66F2\u3057\u305F\u7259\u306F\u3001\u7372\u7269\u3092\u9003\u304C\u3055\u306C\u305F\u3081\u306E\u3082\u306E\u3060\u3002\n\u5468\u56F2\u306B\u6D6E\u304B\u3076\u767A\u5149\u3059\u308B\u773C\u56A2\u306F\u8996\u308B\u306E\u3067\u306F\u306A\u304F\u3001\u7372\u7269\u3092\u300C\u6A19\u8A18\u300D\u3059\u308B\u3002\n\u98DF\u9B3C\u87F2\u306F\u8089\u4F53\u3067\u306F\u306A\u304F\u3001\u6028\u3068\u618E\u3057\u307F\u3001\u6050\u6016\u3092\u5543\u307F\u53D6\u308B\u3002\n\u72D9\u308F\u308C\u305F\u8005\u306F\u5185\u5074\u304B\u3089\u7A7A\u306B\u3055\u308C\u3001\u751F\u304B\u3055\u308C\u305F\u307E\u307E\u6B8B\u3055\u308C\u308B\u3002"
