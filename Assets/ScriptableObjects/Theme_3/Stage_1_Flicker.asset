  m_Name: Stage_1_Flicker
  m_EditorClassIdentifier: 
  stageName: "\u618E\u5922\u5F71"
  stageNameEn: Spitebound Dreamshade
  stageNameJa: "\u618E\u5922\u5F71"
  stageIndex: 1
  isBossStage: 0
  description: "\u6C92\u6709\u4EBA\u77E5\u9053\u4ED6\u8A95\u751F\u65BC\u54EA\u4E00\u5834\u60E1\u5922\uFF0C\u6709\u4EBA\u8AAA\uFF0C\u90A3\u662F\u6028\u6068\u5728\u7121\u6CD5\u9192\u4F86\u6642\uFF0C\u5B78\u6703\u4E86\u5FAE\u7B11\u3002\n\u7576\u4ED6\u51FA\u73FE\uFF0C\u5922\u5883\u6703\u88AB\u67D3\u6210\u7329\u7D05\uFF0C\u8A18\u61B6\u53CD\u8986\u64AD\u653E\u6700\u75DB\u6068\u7684\u7247\u6BB5\uFF0C\u76F4\u5230\u60C5\u611F\u88AB\u78E8\u6210\u5C16\u523A\u3002\n\u4ED6\u4E0D\u8FFD\u9010\u8089\u9AD4\uFF0C\u53EA\u7DCA\u8CBC\u5FC3\u667A\uFF0C\u5728\u4F60\u6700\u4E0D\u60F3\u56DE\u60F3\u7684\u77AC\u9593\uFF0C\u4F4E\u8072\u63D0\u9192\u4F60\u9084\u8A18\u5F97\u4EC0\u9EBC\u3002\n\u51E1\u88AB\u4ED6\u7E8F\u4E0A\u7684\u4EBA\uFF0C\u5C07\u5728\u6E05\u9192\u4E2D\u6301\u7E8C\u4F5C\u5922\uFF0C\u800C\u5922\u88E1\u7684\u6BCF\u4E00\u6B21\u618E\u6068\uFF0C\u90FD\u662F\u4ED6\u8B8A\u5F97\u66F4\u6E05\u6670\u7684\u990A\u5206\u3002"
  descriptionEn: "No one knows which nightmare birthed it\u2014some say it is hatred
    that learned to smile when it could no longer wake.\nWhen it appears, dreams
    turn crimson and memories sharpen into barbs.\nIt clings to the mind, not the
    flesh, feeding on hatred as its victims dream while awake."
  descriptionJa: "\u305D\u308C\u304C\u3069\u306E\u60AA\u5922\u304B\u3089\u751F\u307E\u308C\u305F\u306E\u304B\u3001\u77E5\u308B\u8005\u306F\u3044\u306A\u3044\u3002\n\u76EE\u899A\u3081\u308B\u3053\u3068\u306E\u3067\u304D\u306A\u3044\u618E\u3057\u307F\u304C\u3001\u3084\u304C\u3066\u7B11\u307F\u3092\u899A\u3048\u305F\u59FF\u3060\u3068\u8A9E\u308B\u8005\u3082\u3044\u308B\u3002\n\u5F7C\u304C\u73FE\u308C\u308B\u3068\u3001\u5922\u306F\u6DF1\u7D05\u306B\u67D3\u307E\u308A\u3001\u6700\u3082\u5FCC\u307E\u308F\u3057\u3044\u8A18\u61B6\u304C\u4F55\u5EA6\u3082\u518D\u751F\u3055\u308C\u3001\u611F\u60C5\u306F\u68D8\u3078\u3068\u524A\u3089\u308C\u3066\u3044\u304F\u3002\n\u5F7C\u306F\u8089\u4F53\u3092\u8FFD\u308F\u306A\u3044\u3002\u305F\u3060\u5FC3\u306B\u8CBC\u308A\u3064\u304D\u3001\u601D\u3044\u51FA\u3057\u305F\u304F\u306A\u3044\u77AC\u9593\u306B\u3001\u307E\u3060\u899A\u3048\u3066\u3044\u308B\u3060\u308D\u3046\u3068\u4F4E\u304F\u56C1\u304F\u3002\n\u5F7C\u306B\u7D61\u3081\u53D6\u3089\u308C\u305F\u8005\u306F\u3001\u76EE\u899A\u3081\u305F\u307E\u307E\u5922\u3092\u898B\u7D9A\u3051\u3001\n\u5922\u306E\u4E2D\u3067\u751F\u307E\u308C\u308B\u618E\u60AA\u306E\u4E00\u3064\u4E00\u3064\u304C\u3001\u5F7C\u3092\u3088\u308A\u9BAE\u660E\u306B\u3059\u308B\u7CE7\u3068\u306A\u308B\u3002"
