  m_Name: Stage_9_Spiral_Collapse
  m_EditorClassIdentifier: 
  stageName: "\u8755\u7E8F\u7378"
  stageNameEn: Erosion Coil Beast
  stageNameJa: "\u8755\u7E8F\u7378"
  stageIndex: 9
  isBossStage: 1
  description: "\u5B83\u5011\u4E0D\u770B\u5916\u754C\uFF0C\u53EA\u51DD\u8996\u81EA\u8EAB\u6DF1\u8655\u7684\u88C2\u53E3\u3002\n\u9F52\u9593\u4E0D\u65B7\u6EF4\u843D\u6DB2\u9AD4\uFF0C\u7121\u8072\u3001\u537B\u7559\u4E0B\u75D5\u8DE1\u3002\u8755\u7E8F\u7378\u4E0D\u8FFD\u9010\uFF0C\u4E5F\u4E0D\u5486\u54EE\u2014\u2014\n\u4E00\u65E6\u9760\u8FD1\uFF0C\u4FBF\u958B\u59CB\u7E8F\u7E5E\u3002\u4E0D\u662F\u541E\u566C\uFF0C\u800C\u662F\u628A\u76EE\u6A19\u62D6\u9032\u5B83\u6C38\u9060\u672A\u5B8C\u6210\u7684\u9032\u98DF\u4E4B\u4E2D\u3002"
  descriptionEn: "They do not watch the outside world, only the fissures within themselves.\nLiquid
    drips endlessly from between their teeth\u2014silent, yet leaving unmistakable
    traces.\nErosion Coil Beasts neither pursue nor roar.\nOnce they draw near, they
    begin to coil\u2014not to devour, but to drag their target into an act of feeding
    that is never completed."
  descriptionJa: "\u305D\u308C\u3089\u306F\u5916\u754C\u3092\u898B\u306A\u3044\u3002\n\u51DD\u8996\u3057\u3066\u3044\u308B\u306E\u306F\u3001\u81EA\u8EAB\u306E\u5185\u5074\u306B\u8D70\u308B\u88C2\u3051\u76EE\u3060\u3051\u3060\u3002\n\u6B6F\u306E\u9699\u9593\u304B\u3089\u306F\u6DB2\u4F53\u304C\u7D76\u3048\u305A\u6EF4\u308A\u843D\u3061\u3001\u97F3\u3082\u306A\u304F\u3001\u3057\u304B\u3057\u78BA\u304B\u306A\u75D5\u8DE1\u3092\u6B8B\u3057\u3066\u3044\u304F\u3002\n\u8755\u7E8F\u7363\u306F\u8FFD\u308F\u305A\u3001\u5486\u54EE\u3082\u3057\u306A\u3044\u3002\n\u3072\u3068\u305F\u3073\u8FD1\u3065\u3051\u3070\u3001\u305F\u3060\u7D61\u307F\u3064\u304F\u3060\u3051\u3060\u3002\n\u305D\u308C\u306F\u6355\u98DF\u3067\u306F\u306A\u3044\u2015\u2015\n\u6C7A\u3057\u3066\u7D42\u308F\u308B\u3053\u3068\u306E\u306A\u3044\u300C\u6442\u98DF\u300D\u306E\u4E2D\u3078\u3001\u6A19\u7684\u3092\u5F15\u304D\u305A\u308A\u8FBC\u3080\u884C\u70BA\u306A\u306E\u3060\u3002"
