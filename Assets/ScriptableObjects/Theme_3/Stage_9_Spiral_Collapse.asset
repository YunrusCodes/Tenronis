  m_Name: Stage_9_Spiral_Collapse
  m_EditorClassIdentifier: 
  stageName: "\u8755\u7E8F\u7378"
  stageNameEn: Erosion Coil Beast
  stageNameJa: "\u8755\u7E8F\u7378"
  stageIndex: 9
  isBossStage: 1
  description: "\u6CE8\u610F\u90A3\u500B\u59FF\u614B\u2014\u2014\u5B83\u8DB4\u8457\uFF0C\u4FEF\u8996\uFF0C\u516B\u817F\u5F35\u958B\u3002\n\u5B83\u4E0D\u662F\u5728\u885D\uFF0C\u5B83\u5728\u7B49\u4F60\u8D70\u9032\u5B83\u7684\u4E0B\u65B9\u3002\n\u4E03\u9846\u773C\u775B\u6C92\u6709\u4E00\u9846\u770B\u5411\u5916\u754C\u2014\u2014\u5B83\u5011\u53EA\u51DD\u8996\u81EA\u8EAB\u6DF1\u8655\u7684\u88C2\u53E3\u3002\n\u9F52\u9593\u4E0D\u65B7\u6709\u6771\u897F\u5728\u6EF4\uFF0C\u7121\u8072\u537B\u7559\u4E0B\u75D5\u8DE1\u3002\n\u5B83\u4E0D\u8FFD\uFF0C\u4E5F\u4E0D\u5486\u54EE\u3002\n\u4E00\u65E6\u9760\u8FD1\uFF0C\u5C31\u958B\u59CB\u7E8F\u7E5E\u3002\n\u4E0D\u662F\u541E\u566C\uFF0C\u662F\u628A\u4F60\u62D6\u9032\u4E00\u4EF6\u6C38\u9060\u6C92\u8FA6\u6CD5\u7D50\u675F\u7684\u4E8B\u3002"
  descriptionEn: "Notice that posture—crouched, looking down, eight legs spread wide.\nIt is not charging. It is waiting for you to walk underneath it.\nNot one of those seven eyes is looking outward—they are all fixed on the fissures deep within itself.\nSomething drips continuously from between its teeth, silent but leaving traces.\nIt does not chase. It does not roar.\nOnce you are close enough, it begins to coil.\nNot to devour. To drag you into something that will never be finished."
  descriptionJa: "\u3042\u306E\u59FF\u52E2\u306B\u6CE8\u76EE\u3057\u308D\u2014\u2014\u4F0F\u305B\u3066\u3001\u4FEF\u77B0\u3057\u3001\u516B\u672C\u306E\u811A\u3092\u5E83\u3052\u3066\u3044\u308B\u3002\n\u7A81\u9032\u3057\u3066\u3044\u308B\u306E\u3067\u306F\u306A\u3044\u3002\u3042\u306A\u305F\u304C\u305D\u306E\u4E0B\u3078\u5165\u3063\u3066\u304F\u308B\u306E\u3092\u5F85\u3063\u3066\u3044\u308B\u306E\u3060\u3002\n\u4E03\u3064\u306E\u773C\u306F\u4E00\u3064\u3082\u5916\u3092\u5411\u3044\u3066\u3044\u306A\u3044\u2014\u2014\u3059\u3079\u3066\u81EA\u8EAB\u306E\u5185\u5074\u306E\u88C2\u3051\u76EE\u3092\u51DD\u8996\u3057\u3066\u3044\u308B\u3002\n\u6B6F\u306E\u9593\u304B\u3089\u4F55\u304B\u304C\u7D76\u3048\u305A\u6EF4\u308A\u843D\u3061\u308B\u3002\u97F3\u3082\u306A\u304F\u3001\u3057\u304B\u3057\u75D5\u8DE1\u3092\u6B8B\u3057\u306A\u304C\u3089\u3002\n\u8FFD\u308F\u306A\u3044\u3002\u5486\u54EE\u3082\u3057\u306A\u3044\u3002\n\u4E00\u5EA6\u8FD1\u3065\u3051\u3070\u3001\u7D61\u307F\u3064\u304D\u59CB\u3081\u308B\u3002\n\u55B0\u3089\u3046\u306E\u3067\u306F\u306A\u3044\u3002\u6C38\u9060\u306B\u7D42\u308F\u3089\u306A\u3044\u4F55\u304B\u3078\u3001\u5F15\u304D\u305A\u308A\u8FBC\u3080\u3002"
