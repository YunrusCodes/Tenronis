  stageName: "\u8755\u7E8F\u7378"
  stageIndex: 9
  isBossStage: 1
  description: "\u5B83\u5011\u4E0D\u770B\u5916\u754C\uFF0C\u53EA\u51DD\u8996\u81EA\u8EAB\u6DF1\u8655\u7684\u88C2\u53E3\u3002\n\u9F52\u9593\u4E0D\u65B7\u6EF4\u843D\u6DB2\u9AD4\uFF0C\u7121\u8072\u3001\u537B\u7559\u4E0B\u75D5\u8DE1\u3002\u8755\u7E8F\u7378\u4E0D\u8FFD\u9010\uFF0C\u4E5F\u4E0D\u5486\u54EE\u2014\u2014\n\u4E00\u65E6\u9760\u8FD1\uFF0C\u4FBF\u958B\u59CB\u7E8F\u7E5E\u3002\u4E0D\u662F\u541E\u566C\uFF0C\u800C\u662F\u628A\u76EE\u6A19\u62D6\u9032\u5B83\u6C38\u9060\u672A\u5B8C\u6210\u7684\u9032\u98DF\u4E4B\u4E2D\u3002"
  rewardBuffCount: 3
  maxHp: 1600
