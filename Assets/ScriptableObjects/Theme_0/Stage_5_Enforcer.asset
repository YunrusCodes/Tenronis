  tips:
  - "\u65B9\u584A\u6EA2\u51FA\u662F\u9700\u8981\u4EE3\u50F9\u7684\uFF0C\u5982\u679C\u4F60\u7121\u6CD5\u511F\u9084\uFF0C\u5C31\u6703\u8B8A\u5F97\u4E0D\u5835\u4E00\u64CA"
  - "\u5FC5\u8981\u7684\u6642\u5019\u5C31\u628A\u65B9\u584A\u5806\u7206\u5427\uFF0C\u6E05\u6383\u6230\u5834\uFF0C\u9806\u4FBF\u4F86\u767C\u5927\u7684"
