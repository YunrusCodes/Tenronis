  m_Name: Stage_5_Enforcer
  m_EditorClassIdentifier: 
  stageName: "\u6F14\u7FD2\u7528\u6230\u8ECA"
  stageNameEn: Training War Tank
  stageNameJa: "\u6F14\u7FD2\u7528\u6226\u8ECA"
  stageIndex: 5
  isBossStage: 1
  description: "\u8A66\u8457\u4F7F\u7528\u885D\u64CA\u70AE\u6467\u6BC0\u9019\u5805\u56FA\u7684\u73A9\u610F\u5427!\n\n[\u8AAA\u660E]\n\u53CD\u64CA\u6216\u5B8C\u6574\u6392\u5217\u6574\u6392\u65B9\u584A\u89F8\u767C\u6D88\u9664\u6642\uFF0C\u6703\u7D2F\u7A4D\u885D\u64CA\u70AE\u5145\u80FD\u3002\n\u65B9\u584A\u6EA2\u51FA\u6642\u6703\u6703\u6D88\u801775cp\uFF0C\u91CB\u653E\u5145\u80FD\u4E26\u9020\u6210\u5C0D\u7B49\u50B7\u5BB3\u3002\n\n[\u6280\u5DE7]\n\u5728\u6EFF\u5145\u80FD\u7684\u72C0\u614B\u4E0B\u523B\u610F\u8B93\u65B9\u584A\u6EA2\u51FA\u80FD\u5C0D\u6575\u4EBA\u9020\u6210\u9245\u984D\u50B7\u5BB3\u3002"
  descriptionEn: 'Try using the Impact Cannon to smash this heavily armored machine!


    [Instructions]

    Impact
    Cannon charge is accumulated when triggering a counterattack or clearing a full
    line of blocks.

    When blocks overflow, 75 CP is consumed to release the stored
    charge and deal equivalent damage.


    [Tips]

    Intentionally causing block
    overflow \nwhile at full charge can deal \nmassive damage to the enemy.'
  descriptionJa: "\u885D\u6483\u7832\u3092\u4F7F\u3063\u3066\u3001\u3053\u306E\u5805\u7262\u306A\u4EE3\u7269\u3092\u7C89\u7815\u3057\u3066\u307F\u308D\uFF01\n\n\u3010\u8AAC\u660E\u3011\n\u53CD\u6483\u3001\u307E\u305F\u306F\u30D6\u30ED\u30C3\u30AF\u3092\u6A2A\u4E00\u5217\u63C3\u3048\u3066\u6D88\u53BB\u3059\u308B\u3068\u3001\u885D\u6483\u7832\u306E\u30C1\u30E3\u30FC\u30B8\u304C\u84C4\u7A4D\u3055\u308C\u308B\u3002\n\u30D6\u30ED\u30C3\u30AF\u304C\u30AA\u30FC\u30D0\u30FC\u30D5\u30ED\u30FC\u3059\u308B\u3068\u300175CP\u3092\u6D88\u8CBB\u3057\u3066\u30C1\u30E3\u30FC\u30B8\u3092\u89E3\u653E\u3057\u3001\u540C\u7B49\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002\n\n\u3010\u30C6\u30AF\u30CB\u30C3\u30AF\u3011\n\u30D5\u30EB\u30C1\u30E3\u30FC\u30B8\u72B6\u614B\u3067\u610F\u56F3\u7684\u306B\u30D6\u30ED\u30C3\u30AF\u3092\u6EA2\u308C\u3055\u305B\u308B\u3053\u3068\u3067\u3001\u6575\u306B\u751A\u5927\u306A\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3089\u308C\u308B\u3002"
