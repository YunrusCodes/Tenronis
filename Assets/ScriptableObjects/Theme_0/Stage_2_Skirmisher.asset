  m_Name: Stage_2_Skirmisher
  m_EditorClassIdentifier: 
  stageName: "\u6F14\u7FD2\u7528\u6295\u77F3\u6A5F"
  stageNameEn: Training Trebuchet
  stageNameJa: "\u6F14\u7FD2\u7528\u6295\u77F3\u6A5F"
  stageIndex: 2
  isBossStage: 0
  description: "\u63A5\u4E0B\u4F86\u6703\u958B\u59CB\u6A21\u64EC\u5BE6\u6230\u653B\u64CA\u4F60\uFF0C\u770B\u770B\u4F60\u5982\u4F55\u62B5\u64CB\u653B\u52E2\n\n[\u8AAA\u660E]\n\u6575\u65B9\u5B50\u5F48\u6703\u6301\u7E8C\u843D\u4E0B\uFF0C\u7834\u58DE\u6389\u843D\u7684\u65B9\u584A\n\u5B50\u5F48\u82E5\u6389\u843D\u81F3\u5E95\u90E8\uFF0C\u6703\u9020\u6210\u57CE\u5821\u53D7\u640D\n\u57CE\u5821\u8010\u4E45\u6B78\u96F6\uFF0C\u5373\u5BA3\u544A\u5931\u5B88\u3002"
  descriptionEn: "Next, a simulated combat assault will begin.\nLet\u2019s see how
    you withstand the incoming attack\n\n[Instructions]\nEnemy projectiles will continuously
    fall, destroying blocks they strike.\nIf a projectile reaches the bottom, the
    castle will take damage.\nWhen the castle\u2019s durability reaches zero, the
    defense is considered lost."
  descriptionJa: "\u3053\u308C\u3088\u308A\u5B9F\u6226\u3092\u60F3\u5B9A\u3057\u305F\u653B\u6483\u3092\u958B\u59CB\u3059\u308B\u3002\n\u3069\u3053\u307E\u3067\u653B\u52E2\u3092\u9632\u304E\u304D\u308C\u308B\u304B\u3001\u898B\u305B\u3066\u3082\u3089\u304A\u3046\u3002\n\n\u3010\u8AAC\u660E\u3011\n\u6575\u306E\u5F3E\u306F\u7D99\u7D9A\u7684\u306B\u843D\u4E0B\u3057\u3001\u63A5\u89E6\u3057\u305F\u30D6\u30ED\u30C3\u30AF\u3092\u7834\u58CA\u3059\u308B\u3002\n\u5F3E\u304C\u6700\u4E0B\u90E8\u307E\u3067\u5230\u9054\u3059\u308B\u3068\u3001\u57CE\u304C\u640D\u50B7\u3092\u53D7\u3051\u308B\u3002\n\u57CE\u306E\u8010\u4E45\u5024\u304C\u30BC\u30ED\u306B\u306A\u308B\u3068\u3001\u9632\u885B\u5931\u6557\u3068\u306A\u308B\u3002"
