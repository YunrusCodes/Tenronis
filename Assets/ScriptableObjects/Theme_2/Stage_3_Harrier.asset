  m_Name: Stage_3_Harrier
  m_EditorClassIdentifier: 
  stageName: "\u673D\u5996"
  stageNameEn: Rotbound Wraith
  stageNameJa: "\u673D\u5996"
  stageIndex: 3
  isBossStage: 0
  description: "\u5F9E\u5B83\u8EAB\u4E0A\u6709\u6771\u897F\u5728\u5F80\u4E0B\u6EF4\u3002\n\u4E0D\u50CF\u50B7\u53E3\uFF0C\u66F4\u50CF\u662F\u67D0\u7A2E\u6771\u897F\u4E00\u76F4\u5728\u5F9E\u5B83\u90A3\u88E1\u96E2\u958B\uFF0C\u537B\u6C92\u8FA6\u6CD5\u5B8C\u5168\u8D70\u6389\u3002\n\u90A3\u4EF6\u6597\u7BF7\u662F\u675F\u7E1B\uFF0C\u4E0D\u662F\u7A7F\u7684\u2014\u2014\u88E1\u9762\u88DD\u8457\u67D0\u7A2E\u4E0D\u8A72\u7E7C\u7E8C\u5B58\u5728\u7684\u610F\u5FD7\u3002\n\u90A3\u500B\u7B11\u5BB9\u662F\u88C2\u7E2B\uFF0C\u4E0D\u662F\u8868\u60C5\u3002\u9ED1\u6697\u5F9E\u90A3\u88E1\u51FA\u4F86\uFF0C\u56E0\u70BA\u5B83\u6C92\u6709\u5225\u7684\u5730\u65B9\u53EF\u53BB\u3002"
  descriptionEn: "Something is dripping from it.\nNot like a wound—more like something has been leaving it continuously, unable to leave all the way.\nThat cloak is a restraint, not clothing—it is holding in something that should no longer exist.\nThat grin is a fracture, not an expression. Darkness comes through it because it has nowhere else to go."
  descriptionJa: "\u305D\u308C\u304B\u3089\u4F55\u304B\u304C\u6EF4\u308A\u843D\u3061\u3066\u3044\u308B\u3002\n\u50B7\u53E3\u306E\u3088\u3046\u3067\u306F\u306A\u3044\u3002\u4F55\u304B\u304C\u7D76\u3048\u305A\u305D\u3053\u304B\u3089\u96E2\u308C\u3088\u3046\u3068\u3057\u3066\u3044\u308B\u304C\u3001\u5B8C\u5168\u306B\u306F\u53BB\u308C\u306A\u3044\u3088\u3046\u306B\u898B\u3048\u308B\u3002\n\u3042\u306E\u6597\u7BF7\u306F\u675F\u7E1B\u3067\u3042\u308A\u3001\u7E8F\u3046\u3082\u306E\u3067\u306F\u306A\u3044\u2014\u2014\u5B58\u5728\u3057\u7D9A\u3051\u308B\u3079\u304D\u3067\u306A\u3044\u610F\u5FD7\u3092\u3001\u4E2D\u306B\u62B1\u3048\u3066\u3044\u308B\u3002\n\u3042\u306E\u7B11\u307F\u306F\u88C2\u3051\u76EE\u3067\u3042\u308A\u3001\u8868\u60C5\u3067\u306F\u306A\u3044\u3002\u95C7\u306F\u305D\u3053\u304B\u3089\u51FA\u3066\u304F\u308B\u3002\u4ED6\u306B\u884C\u304D\u5834\u304C\u306A\u3044\u304B\u3089\u3002"
