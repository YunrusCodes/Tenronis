  stageName: "\u6BC0\u942E"
  stageIndex: 9
  isBossStage: 1
  description: "\u7576\u4ED6\u964D\u81E8\uFF0C\u706B\u7130\u4E0D\u518D\u53EA\u662F\u71C3\u71D2\uFF0C\u800C\u662F\u958B\u59CB\u57F7\u884C\u2014\u2014\u6467\u6BC0\u3001\u6E05\u7A7A\u3001\u6B78\u96F6\u3002\n\u90A3\u5C0D\u5C55\u958B\u7684\u706B\u7FFC\u4E0D\u662F\u98DB\u7FD4\u7684\u5DE5\u5177\uFF0C\u800C\u662F\u5BA3\u544A\u7BC4\u570D\u7684\u754C\u7DDA\uFF1B\n\u51E1\u88AB\u7FFC\u5F71\u8986\u84CB\u4E4B\u5730\uFF0C\u5B58\u5728\u7684\u610F\u7FA9\u90FD\u6703\u88AB\u9010\u4E00\u525D\u9664\u3002\n\u4ED6\u624B\u4E2D\u7684\u9396\u93C8\u8207\u942E\u5203\uFF0C\u4E26\u975E\u5211\u5177\uFF0C\u800C\u662F\u79E9\u5E8F\u5D29\u89E3\u5F8C\uFF0C\u552F\u4E00\u5269\u4E0B\u7684\u8A9E\u8A00\u3002"
  rewardBuffCount: 3
