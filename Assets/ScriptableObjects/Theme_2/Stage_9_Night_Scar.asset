  m_Name: Stage_9_Night_Scar
  m_EditorClassIdentifier: 
  stageName: "\u6BC0\u942E"
  stageNameEn: Annihilation Scythe
  stageNameJa: "\u6BC0\u942E"
  stageIndex: 9
  isBossStage: 1
  description: "\u7576\u4ED6\u964D\u81E8\uFF0C\u706B\u7130\u4E0D\u518D\u53EA\u662F\u71C3\u71D2\uFF0C\u800C\u662F\u958B\u59CB\u57F7\u884C\u2014\u2014\u6467\u6BC0\u3001\u6E05\u7A7A\u3001\u6B78\u96F6\u3002\n\u90A3\u5C0D\u5C55\u958B\u7684\u706B\u7FFC\u4E0D\u662F\u98DB\u7FD4\u7684\u5DE5\u5177\uFF0C\u800C\u662F\u5BA3\u544A\u7BC4\u570D\u7684\u754C\u7DDA\uFF1B\n\u51E1\u88AB\u7FFC\u5F71\u8986\u84CB\u4E4B\u5730\uFF0C\u5B58\u5728\u7684\u610F\u7FA9\u90FD\u6703\u88AB\u9010\u4E00\u525D\u9664\u3002\n\u4ED6\u624B\u4E2D\u7684\u9396\u93C8\u8207\u942E\u5203\uFF0C\u4E26\u975E\u5211\u5177\uFF0C\u800C\u662F\u79E9\u5E8F\u5D29\u89E3\u5F8C\uFF0C\u552F\u4E00\u5269\u4E0B\u7684\u8A9E\u8A00\u3002"
  descriptionEn: "When it descends, fire ceases to burn and begins to execute\u2014erasing
    all things to zero.\nIts wings of flame declare a boundary, within which existence
    is stripped of meaning.\nThe chains and scythe are not punishment, but the last
    language left after order collapses."
  descriptionJa: "\u5F7C\u304C\u964D\u81E8\u3059\u308B\u3068\u3001\u708E\u306F\u3082\u306F\u3084\u71C3\u3048\u5E83\u304C\u308B\u3060\u3051\u306E\u3082\u306E\u3067\u306F\u306A\u304F\u306A\u308B\u3002\u305D\u308C\u306F\u5B9F\u884C\u3092\u59CB\u3081\u308B\u2015\u2015\u7834\u58CA\u3001\u6E05\u7B97\u3001\u305D\u3057\u3066\u30BC\u30ED\u3078\u306E\u56DE\u5E30\u3092\u3002\u5E83\u3052\u3089\u308C\u305F\u706B\u7FFC\u306F\u98DB\u7FD4\u306E\u305F\u3081\u3067\u306F\u306A\u3044\u3002\n\u305D\u308C\u306F\u7BC4\u56F2\u3092\u5BA3\u544A\u3059\u308B\u5883\u754C\u7DDA\u3060\u3002\n\u7FFC\u5F71\u306B\u8986\u308F\u308C\u305F\u5730\u3067\u306F\u3001\u5B58\u5728\u306E\u610F\u5473\u304C\u4E00\u3064\u305A\u3064\u5265\u304E\u53D6\u3089\u308C\u3066\u3044\u304F\u3002\u624B\u306B\u3057\u305F\u9396\u3068\u938C\u306F\u5211\u5177\u3067\u306F\u306A\u3044\u3002\n\u79E9\u5E8F\u304C\u5D29\u58CA\u3057\u305F\u5F8C\u306B\u3001\u306A\u304A\u6B8B\u3055\u308C\u305F\u552F\u4E00\u306E\u8A00\u8A9E\u306A\u306E\u3060\u3002"
