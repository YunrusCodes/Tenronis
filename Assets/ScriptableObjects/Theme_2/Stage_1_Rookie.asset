  m_Name: Stage_1_Rookie
  m_EditorClassIdentifier: 
  stageName: "\u673D\u5F71"
  stageNameEn: Decaying Shade
  stageNameJa: "\u673D\u5F71"
  stageIndex: 1
  isBossStage: 0
  description: "\u6709\u4EBA\u8AAA\uFF0C\u90A3\u662F\u5728\u4E16\u754C\u7B2C\u4E00\u6B21\u5931\u53BB\u610F\u7FA9\u6642\u7559\u4E0B\u7684\u6B98\u6E23\u3002\n\u7576\u4ED6\u9760\u8FD1\uFF0C\u4E8B\u7269\u4E26\u4E0D\u6703\u5D29\u58DE\uFF0C\u537B\u6703\u6084\u7136\u5931\u53BB\u5B58\u5728\u7684\u7406\u7531\uFF0C\u5F77\u5F7F\u65E9\u5DF2\u8150\u673D\uFF0C\u53EA\u662F\u73FE\u5728\u624D\u88AB\u5BDF\u89BA\u3002\n\u90A3\u5C0D\u523A\u773C\u7684\u767D\u5149\u4E4B\u773C\u4E0D\u662F\u5728\u6CE8\u8996\u4F60\uFF0C\u4ED6\u626D\u66F2\u7684\u8EAB\u5F71\u4E0D\u65B7\u8815\u52D5\uFF0C\u50CF\u662F\u5728\u52AA\u529B\u7DAD\u6301\u5F62\u9AD4\uFF0C\u53C8\u50CF\u662F\u5728\u6297\u62D2\u5FB9\u5E95\u6D88\u6563\u3002"
  descriptionEn: "Some say it is the residue left behind when the world first lost
    its meaning.\nAs it draws near, things do not collapse, but quietly lose their
    reason to exist, as if they had long been rotten, only now noticed.\nThose piercing
    white eyes are not watching you; its warped form writhes endlessly, as if struggling
    to hold its shape\u2014or resisting total dissolution."
  descriptionJa: "\u305D\u308C\u306F\u3001\u4E16\u754C\u304C\u521D\u3081\u3066\u610F\u5473\u3092\u5931\u3063\u305F\u77AC\u9593\u306B\u6B8B\u3055\u308C\u305F\u6B8B\u6ED3\u3060\u3068\u8A00\u308F\u308C\u3066\u3044\u308B\u3002\n\u5F7C\u304C\u8FD1\u3065\u3044\u3066\u3082\u3001\u7269\u4E8B\u306F\u5D29\u308C\u53BB\u308B\u3053\u3068\u306F\u306A\u3044\u3002\u305F\u3060\u9759\u304B\u306B\u5B58\u5728\u3059\u308B\u7406\u7531\u3092\u5931\u3063\u3066\u3044\u304F\u2015\u2015\n\u307E\u308B\u3067\u305A\u3063\u3068\u673D\u3061\u3066\u3044\u305F\u3082\u306E\u304C\u3001\u4ECA\u306B\u306A\u3063\u3066\u6C17\u3065\u304B\u308C\u305F\u3060\u3051\u306E\u3088\u3046\u306B\u3002\n\u7729\u3044\u767D\u5149\u3092\u653E\u3064\u305D\u306E\u773C\u306F\u3001\u3042\u306A\u305F\u3092\u898B\u3066\u3044\u308B\u308F\u3051\u3067\u306F\u306A\u3044\u3002\n\u6B6A\u3093\u3060\u305D\u306E\u5F71\u306F\u7D76\u3048\u305A\u8822\u304D\u3001\u5F62\u3092\u4FDD\u3068\u3046\u3068\u3057\u3066\u3044\u308B\u306E\u304B\u3001\u305D\u308C\u3068\u3082\u5B8C\u5168\u306A\u6D88\u6EC5\u306B\u6297\u3063\u3066\u3044\u308B\u306E\u304B\u3001\u5224\u5225\u306F\u3064\u304B\u306A\u3044\u3002"
