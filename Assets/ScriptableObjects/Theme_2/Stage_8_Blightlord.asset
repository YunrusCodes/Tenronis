  m_Name: Stage_8_Blightlord
  m_EditorClassIdentifier: 
  stageName: "\u6607\u5F71"
  stageNameEn: Ascendant Ember
  stageNameJa: "\u6607\u5F71"
  stageIndex: 8
  isBossStage: 0
  description: "\u711A\u5F71\u662F\u706B\u5B78\u6703\u7B11\u5BB9\u7684\u5F62\u72C0\u3002\u9019\u500B\uFF0C\u662F\u706B\u5B78\u6703\u4E86\u5225\u7684\u6771\u897F\u3002\n\u96FB\u6D41\u7A7F\u904E\u5B83\u7684\u8EAB\u9AD4\uFF0C\u50CF\u662F\u67D0\u7A2E\u58D3\u529B\u627E\u5230\u4E86\u88C2\u7E2B\u3002\u5B83\u6BD4\u711A\u5F71\u66F4\u4E0D\u7A69\u5B9A\u2014\u2014\u66F4\u63A5\u8FD1\u7834\u88C2\u7684\u524D\u4E00\u79D2\u3002\n\u70C8\u7130\u4E0D\u518D\u5411\u4E0B\uFF0C\u5B83\u53CD\u5411\u7FFB\u6E67\uFF0C\u50CF\u6574\u500B\u5730\u7344\u90FD\u5728\u8A66\u5716\u8D8A\u754C\u3002\n\u90A3\u500B\u7B11\u5BB9\u4E0D\u662F\u72C2\u559C\uFF0C\u662F\u6399\u812B\u4E4B\u524D\uFF0C\u6700\u5F8C\u4E00\u6B21\u78BA\u8A8D\u4E16\u754C\u662F\u4EC0\u9EBC\u6A23\u5B50\u3002\n\u88AB\u5B83\u7167\u5230\u7684\uFF0C\u6050\u61FC\u6703\u88AB\u707C\u6210\u6E34\u671B\u3002\u7518\u9858\u589C\u5165\u66F4\u6DF1\u7684\u5730\u65B9\u3002"
  descriptionEn: "The Cinder Shade was fire learning the shape of a smile. This is fire learning something else.\nElectrical current runs through its body, as if some pressure found a crack. It is less stable than the Cinder Shade—closer to the moment before breaking open.\nThe flames no longer fall. They surge upward, as if all of hell is trying to cross a boundary.\nThat smile is not ecstasy. It is a final look at the world, just before breaking free.\nThose it illuminates have their fear burned into desire. They follow it willingly into the deeper heat."
  descriptionJa: "\u711A\u5F71\u306F\u708E\u304C\u7B11\u307F\u306E\u5F62\u3092\u5B66\u3093\u3060\u3082\u306E\u3060\u3002\u3053\u308C\u306F\u3001\u708E\u304C\u5225\u306E\u4F55\u304B\u3092\u5B66\u3093\u3060\u3082\u306E\u3060\u3002\n\u96FB\u6D41\u304C\u305D\u306E\u4F53\u3092\u8D70\u308B\u3002\u4F55\u3089\u304B\u306E\u5727\u529B\u304C\u4E80\u88C2\u3092\u898B\u3064\u3051\u305F\u304B\u306E\u3088\u3046\u306B\u3002\u711A\u5F71\u3088\u308A\u4E0D\u5B89\u5B9A\u3067\u3001\u7834\u88C2\u306E\u76F4\u524D\u306B\u8FD1\u3044\u3002\n\u708E\u306F\u3082\u306F\u3084\u4E0B\u3078\u5411\u304B\u308F\u306A\u3044\u3002\u9006\u6D41\u3059\u308B\u3002\u5730\u7344\u5168\u4F53\u304C\u5883\u754C\u3092\u8D8A\u3048\u3088\u3046\u3068\u3057\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u306B\u3002\n\u3042\u306E\u7B11\u307F\u306F\u72C2\u559C\u3067\u306F\u306A\u3044\u3002\u89E3\u304D\u653E\u305F\u308C\u308B\u76F4\u524D\u306B\u3001\u4E16\u754C\u3092\u6700\u5F8C\u306B\u78BA\u304B\u3081\u308B\u8868\u60C5\u3060\u3002\n\u305D\u306E\u5149\u3092\u53D7\u3051\u305F\u8005\u306F\u6050\u6016\u3092\u6E07\u671B\u3078\u3068\u707C\u304B\u308C\u3001\u3088\u308A\u6DF1\u3044\u71BE\u71B1\u3078\u81EA\u3089\u843D\u3061\u3066\u3044\u304F\u3002"
