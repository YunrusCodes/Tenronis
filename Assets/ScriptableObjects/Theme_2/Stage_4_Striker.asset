  m_Name: Stage_4_Striker
  m_EditorClassIdentifier: 
  stageName: "\u984E\u7370"
  stageNameEn: Gnawjaw
  stageNameJa: "\u984E\u7370"
  stageIndex: 4
  isBossStage: 0
  description: "\u770B\u90A3\u500B\u982D\u2014\u2014\u90A3\u9802\u523A\u51A0\u53EA\u662F\u8B93\u4F60\u770B\u90A3\u5F35\u5634\u7684\u6846\u67B6\u3002\n\u90A3\u5F35\u5634\u6BD4\u773C\u775B\u66F4\u5927\u3001\u66F4\u4EAE\u3002\u5B83\u624D\u662F\u9019\u500B\u6771\u897F\u7684\u91CD\u5FC3\uFF0C\u4E0D\u662F\u773C\u775B\u3002\n\u773C\u775B\u6C92\u6709\u7126\u8DDD\u3002\n\u4F46\u90A3\u5F35\u5634\u8A18\u5F97\u3002\u672C\u80FD\u5730\uFF0C\u5728\u627E\u4E0B\u4E00\u6B21\u5F35\u958B\u7684\u7406\u7531\u3002"
  descriptionEn: "Look at the head—that crown of spikes is only a frame to make you look at the mouth.\nThat mouth is larger, brighter than the eyes. It is the center of this thing, not the eyes.\nThe eyes hold no focus.\nBut the mouth remembers. Instinctively, searching for the next reason to open."
  descriptionJa: "\u982D\u3092\u898B\u308D\u2014\u2014\u3042\u306E\u523A\u306E\u51A0\u306F\u3001\u3042\u306E\u53E3\u3092\u898B\u3055\u305B\u308B\u305F\u3081\u306E\u67A0\u306B\u904E\u304E\u306A\u3044\u3002\n\u3042\u306E\u53E3\u306F\u773C\u3088\u308A\u3082\u5927\u304D\u304F\u3001\u660E\u308B\u3044\u3002\u3053\u306E\u5B58\u5728\u306E\u91CD\u5FC3\u306F\u305D\u3053\u306B\u3042\u308A\u3001\u773C\u3067\u306F\u306A\u3044\u3002\n\u773C\u306B\u7126\u70B9\u306F\u306A\u3044\u3002\n\u3060\u304C\u3042\u306E\u53E3\u306F\u899A\u3048\u3066\u3044\u308B\u3002\u672C\u80FD\u7684\u306B\u3001\u6B21\u306B\u958B\u304F\u7406\u7531\u3092\u63A2\u3057\u3066\u3044\u308B\u3002"
