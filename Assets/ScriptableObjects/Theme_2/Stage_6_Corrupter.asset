  m_Name: Stage_6_Corrupter
  m_EditorClassIdentifier: 
  stageName: "\u708E\u9ACF"
  stageNameEn: Infernal Skull
  stageNameJa: "\u708E\u9ACF"
  stageIndex: 6
  isBossStage: 0
  description: "\u90A3\u5177\u9AB8\u9AA8\uFF0C\u662F\u88AB\u6C38\u6046\u4E4B\u706B\u4FDD\u7559\u4E0B\u4F86\u7684\u61F2\u7F70\u3002\n\u7576\u4ED6\u73FE\u8EAB\uFF0C\u5927\u5730\u6703\u9F9C\u88C2\uFF0C\u71B1\u6D6A\u5982\u547C\u5438\u822C\u4E00\u6CE2\u4E00\u6CE2\u64F4\u6563\uFF0C\u9023\u5F71\u5B50\u90FD\u6703\u88AB\u71D2\u5F97\u9000\u7E2E\u3002\n\u90A3\u526F\u71C3\u71D2\u7684\u982D\u9871\u9732\u51FA\u7684\u4E0D\u662F\u7B11\uFF0C\u800C\u662F\u75DB\u82E6\u88AB\u62C9\u9577\u5230\u6975\u9650\u5F8C\uFF0C\u53EA\u5269\u4E0B\u7684\u672C\u80FD\u8868\u60C5\u3002\n\u4ED6\u884C\u8D70\u4E4B\u8655\uFF0C\u6B7B\u4EA1\u4E0D\u518D\u662F\u7D42\u9EDE\u2014\u2014\u800C\u662F\u88AB\u53CD\u8986\u9EDE\u71C3\u7684\u904E\u7A0B\u3002"
  descriptionEn: "That skeleton is a punishment preserved by eternal flame.\nWhen
    it appears, the ground fractures as waves of heat spread like breathing, forcing
    even shadows to recoil.\nThe burning skull bears not a smile, but the final instinctive
    expression left after pain has been stretched beyond its limit.\nWhere it walks,
    death is no longer an end\u2014but a process, ignited again and again."
  descriptionJa: "\u305D\u306E\u9AB8\u9AA8\u306F\u3001\u6C38\u52AB\u306E\u708E\u306B\u3088\u3063\u3066\u6B8B\u3055\u308C\u7D9A\u3051\u308B\u61F2\u7F70\u3060\u3002\n\u5F7C\u304C\u73FE\u308C\u308B\u3068\u5927\u5730\u306F\u3072\u3073\u5272\u308C\u3001\u71B1\u6CE2\u304C\u547C\u5438\u306E\u3088\u3046\u306B\u5E7E\u91CD\u306B\u3082\u5E83\u304C\u308A\u3001\u5F71\u3055\u3048\u3082\u713C\u304B\u308C\u3066\u5F8C\u9000\u3059\u308B\u3002\n\u71C3\u3048\u76DB\u308B\u305D\u306E\u982D\u84CB\u304C\u6D6E\u304B\u3079\u308B\u306E\u306F\u7B11\u307F\u3067\u306F\u306A\u3044\u2015\u2015\n\u82E6\u75DB\u304C\u6975\u9650\u307E\u3067\u5F15\u304D\u5EF6\u3070\u3055\u308C\u305F\u672B\u306B\u6B8B\u3063\u305F\u3001\u672C\u80FD\u3060\u3051\u306E\u8868\u60C5\u3060\u3002\n\u5F7C\u304C\u6B69\u3080\u5834\u6240\u3067\u306F\u3001\u6B7B\u306F\u3082\u306F\u3084\u7D42\u308F\u308A\u3067\u306F\u306A\u3044\u3002\n\u305D\u308C\u306F\u4F55\u5EA6\u3082\u70B9\u706B\u3055\u308C\u308B\u3001\u7D42\u308F\u3089\u306A\u3044\u904E\u7A0B\u3068\u306A\u308B\u3002"
