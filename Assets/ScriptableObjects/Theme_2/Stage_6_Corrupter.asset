  m_Name: Stage_6_Corrupter
  m_EditorClassIdentifier: 
  stageName: "\u708E\u9ACF"
  stageNameEn: Infernal Skull
  stageNameJa: "\u708E\u9ACF"
  stageIndex: 6
  isBossStage: 0
  description: "\u90A3\u500B\u7B11\u5BB9\u662F\u9AA8\u982D\uFF0C\u4E0D\u662F\u8868\u60C5\u2014\u2014\u5B83\u7121\u6CD5\u6539\u8B8A\uFF0C\u4E5F\u4E0D\u6253\u7B97\u6539\u8B8A\u3002\n\u9871\u9AA8\u5728\u6C92\u6709\u808C\u8089\u4E4B\u5F8C\u7559\u4E0B\u7684\u5F62\u72C0\uFF0C\u5C31\u662F\u9019\u6A23\u3002\n\u706B\u5728\u5916\u9762\u5305\u8457\u5B83\uFF0C\u4E0D\u662F\u5B83\u7684\u4E00\u90E8\u5206\u2014\u2014\u66F4\u50CF\u662F\u67D0\u7A2E\u6301\u7E8C\u65BD\u52A0\u7684\u6771\u897F\u3002\n\u5169\u628A\u722A\u5404\u81EA\u7B49\u5F85\u3002\u5728\u5B83\u8D70\u904E\u7684\u5730\u65B9\uFF0C\u6B7B\u4EA1\u4E0D\u662F\u7D42\u9EDE\uFF0C\u662F\u88AB\u53CD\u8986\u9EDE\u71C3\u7684\u904E\u7A0B\u3002"
  descriptionEn: "That smile is bone, not expression—it cannot change, and has no intention of changing.\nThis is what a skull looks like when the muscles are gone.\nFire wraps around it from outside, not as part of it—more like something continuously applied.\nTwo claws, each waiting. Where it walks, death is not an end. It is a process, ignited again and again."
  descriptionJa: "\u3042\u306E\u7B11\u307F\u306F\u9AA8\u3067\u3042\u308A\u3001\u8868\u60C5\u3067\u306F\u306A\u3044\u2014\u2014\u5909\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u305A\u3001\u5909\u3048\u308B\u3064\u3082\u308A\u3082\u306A\u3044\u3002\n\u7B4B\u8089\u304C\u306A\u304F\u306A\u3063\u305F\u5F8C\u306B\u6B8B\u308B\u982D\u84CB\u306E\u5F62\u304C\u3001\u3053\u308C\u3060\u3002\n\u706B\u306F\u5916\u5074\u304B\u3089\u5305\u3093\u3067\u3044\u308B\u3002\u305D\u306E\u4E00\u90E8\u3067\u306F\u306A\u304F\u3001\u7D99\u7D9A\u7684\u306B\u52A0\u3048\u3089\u308C\u308B\u4F55\u304B\u306E\u3088\u3046\u306B\u3002\n\u4E8C\u3064\u306E\u722A\u304C\u3001\u305D\u308C\u305E\u308C\u5F85\u3063\u3066\u3044\u308B\u3002\u305D\u308C\u304C\u6B69\u3080\u5834\u6240\u3067\u306F\u3001\u6B7B\u306F\u7D42\u308F\u308A\u3067\u306F\u306A\u3044\u3002\u4F55\u5EA6\u3082\u70B9\u706B\u3055\u308C\u308B\u904E\u7A0B\u3060\u3002"
