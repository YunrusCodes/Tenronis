  m_Script: {fileID: 11500000, guid: 3fe80882f65a4ff479ef1fca5ee38a6f, type: 3}
  m_Name: Stage_5_Rupturer
  m_EditorClassIdentifier: 
  stageName: "\u711A\u5F71"
  stageNameEn: Cinder Shade
  stageNameJa: "\u711A\u5F71"
  stageIndex: 5
  isBossStage: 1
  description: "\u90A3\u500B\u7B11\u5BB9\u7684\u5F62\u72C0\u2014\u2014\u4F60\u898B\u904E\u3002\n\u773C\u775B\u7684\u4F4D\u7F6E\uFF0C\u7259\u9F52\u7684\u5F27\u5EA6\uFF0C\u662F\u719F\u6089\u7684\u6392\u5217\u3002\n\u4E0D\u4E00\u6A23\u7684\u53EA\u6709\u6750\u8CEA\uFF1A\u73FE\u5728\u9019\u4E9B\u662F\u706B\u505A\u7684\u3002\n\u5730\u7344\u4E4B\u706B\u5B78\u6703\u4E86\u4E00\u4EF6\u4E8B\u3002\n\u5B83\u51FA\u73FE\u6642\uFF0C\u7A7A\u6C23\u81EA\u5DF1\u958B\u59CB\u71C3\u71D2\uFF0C\u9670\u5F71\u5728\u706B\u5149\u88E1\u626D\u66F2\u6210\u75DB\u82E6\u7684\u8F2A\u5ED3\u3002\n\u90A3\u5C0D\u773C\u775B\u4E0D\u662F\u5728\u770B\u2014\u2014\u662F\u5728\u641C\u5C0B\u3002\u9084\u6C92\u88AB\u71D2\u6389\u7684\u6050\u61FC\uFF0C\u5728\u54EA\u88E1\u3002\n\u5B83\u4E0D\u6BC0\u6EC5\u3002\u5B83\u628A\u4E00\u5207\u8F49\u6210\u71C3\u6599\uFF0C\u7559\u4E0B\u7126\u9ED1\u7684\u5F62\u72C0\uFF0C\u8B93\u90A3\u500B\u7B11\u7E7C\u7E8C\u71C3\u71D2\u8457\u3002"
  descriptionEn: "That shape of smile—you have seen it before.\nThe position of the eyes, the arc of the teeth: a familiar arrangement.\nThe only difference is the material. Now it is made of fire.\nHellfire learned one thing.\nWhen it appears, the air begins to ignite on its own, and shadows twist in the firelight into shapes of pain.\nThose eyes are not watching—they are searching. For fear that has not yet been burned.\nIt does not destroy. It converts everything into fuel, leaves behind a charred shape, and lets that smile keep burning."
  descriptionJa: "\u3042\u306E\u7B11\u307F\u306E\u5F62\u2014\u2014\u898B\u305F\u3053\u3068\u304C\u3042\u308B\u3002\n\u773C\u306E\u4F4D\u7F6E\u3001\u6B6F\u306E\u5F27\u5EA6\u3001\u898B\u899A\u3048\u306E\u3042\u308B\u914D\u7F6E\u3060\u3002\n\u9055\u3046\u306E\u306F\u7D20\u6750\u3060\u3051\u3060\u3002\u4ECA\u305D\u308C\u306F\u706B\u3067\u3067\u304D\u3066\u3044\u308B\u3002\n\u5730\u7344\u306E\u708E\u306F\u4E00\u3064\u306E\u3053\u3068\u3092\u5B66\u3093\u3060\u3002\n\u73FE\u308C\u308B\u3068\u3001\u7A7A\u6C17\u306F\u81EA\u3089\u71C3\u3048\u59CB\u3081\u3001\u5F71\u306F\u706B\u5149\u306E\u4E2D\u3067\u82E6\u75DB\u306E\u8F2A\u90ED\u306B\u6B6A\u3080\u3002\n\u3042\u306E\u53CC\u773C\u306F\u898B\u3066\u3044\u308B\u306E\u3067\u306F\u306A\u3044\u2014\u2014\u63A2\u3057\u3066\u3044\u308B\u3002\u307E\u3060\u713C\u304B\u308C\u3066\u3044\u306A\u3044\u6050\u6016\u304C\u3001\u3069\u3053\u306B\u3042\u308B\u304B\u3092\u3002\n\u7834\u58CA\u3057\u306A\u3044\u3002\u3059\u3079\u3066\u3092\u71C3\u6599\u306B\u5909\u3048\u3001\u7126\u3052\u305F\u5F62\u3092\u6B8B\u3057\u3001\u3042\u306E\u7B11\u307F\u3092\u71C3\u3084\u3057\u7D9A\u3051\u308B\u3002"
