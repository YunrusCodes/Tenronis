  m_Name: Stage_10_Abyssal_Maw
  m_EditorClassIdentifier: 
  stageName: "\u95BB\u8755\u738B"
  stageNameEn: Eclipse King of the Inferno
  stageNameJa: "\u95BB\u8755\u738B"
  stageIndex: 10
  isBossStage: 1
  description: "\u6C92\u6709\u4EBA\u77E5\u9053\u4ED6\u662F\u5426\u4ECD\u662F\u738B\uFF0C\u6709\u4EBA\u8AAA\u90A3\u53EA\u662F\u7149\u7344\u5728\u541E\u566C\u81EA\u5DF1\u5F8C\uFF0C\u6B98\u7559\u4E0B\u4F86\u7684\u6838\u5FC3\u610F\u5FD7\u3002\n\u7576\u4ED6\u986F\u73FE\uFF0C\u706B\u7130\u4E0D\u518D\u5206\u8FA8\u500B\u9AD4\uFF0C\u842C\u5343\u4EA1\u5F71\u88AB\u7194\u9444\u70BA\u540C\u4E00\u5177\u5F62\u9AD4\uFF0C\u5728\u4ED6\u5468\u8EAB\u4F4E\u8072\u54C0\u568E\u3002\n\u90A3\u5F35\u5C64\u5C64\u758A\u5408\u7684\u7259\u53E3\u53CD\u8986\u5BA3\u544A\u8457\u2014\u2014\u6B7B\u4EA1\uFF0C\u5F9E\u4F86\u4E0D\u662F\u89E3\u812B\u3002\n\u74B0\u7E5E\u4ED6\u7684\u8AF8\u591A\u711A\u9996\uFF0C\u6B63\u662F\u88AB\u4ED6\u4FB5\u8755\u5F8C\u4ECD\u672A\u7184\u6EC5\u7684\u610F\u5FD7\u788E\u7247\uFF0C\u6C38\u9060\u88AB\u8FEB\u898B\u8B49\u7D42\u5C40\u3002"
  descriptionEn: "No one knows if it remains a king\u2014some say it is the core
    will left after the inferno consumed itself.When it manifests, flame erases individuality,
    fusing countless dead into one wailing form.\nIts layered maws proclaim that
    death is never release, while the burning heads that orbit it are unextinguished
    fragments forced to witness the end."
  descriptionJa: "\u5F7C\u304C\u4ECA\u3082\u300C\u738B\u300D\u306A\u306E\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u3002\n\u7149\u7344\u304C\u81EA\u3089\u3092\u55B0\u3089\u3063\u305F\u672B\u306B\u6B8B\u3055\u308C\u305F\u3001\u6838\u3068\u306A\u308B\u610F\u5FD7\u3060\u3068\u8A9E\u3089\u308C\u3066\u3044\u308B\u3002\n\u9855\u73FE\u3068\u3068\u3082\u306B\u708E\u306F\u500B\u3092\u5931\u3044\u3001\u4EA1\u5F71\u306F\u6EB6\u3051\u5408\u3044\u4E00\u3064\u306E\u5F62\u3068\u306A\u3063\u3066\u5606\u304D\u7D9A\u3051\u308B\u3002\n\u91CD\u306A\u308A\u5408\u3046\u7259\u306F\u544A\u3052\u308B\u2015\u2015\u6B7B\u306F\u6C7A\u3057\u3066\u89E3\u653E\u3067\u306F\u306A\u3044\u3002\n\u5468\u56F2\u3092\u5DE1\u308B\u711A\u9996\u306F\u3001\u4FB5\u8755\u3055\u308C\u3066\u3082\u6D88\u3048\u304D\u3089\u306A\u304B\u3063\u305F\u610F\u5FD7\u306E\u65AD\u7247\u3060\u3002"
