  m_Script: {fileID: 11500000, guid: 3fe80882f65a4ff479ef1fca5ee38a6f, type: 3}
  m_Name: Stage_10_Abyssal_Maw
  m_EditorClassIdentifier: 
  stageName: "\u95BB\u8755\u738B"
  stageNameEn: Eclipse King of the Inferno
  stageNameJa: "\u95BB\u8755\u738B"
  stageIndex: 10
  isBossStage: 1
  description: "\u6CE8\u610F\u90A3\u4E9B\u982D\u9871\u2014\u2014\u5B83\u5011\u5404\u81EA\u6709\u773C\u775B\uFF0C\u5404\u81EA\u9084\u5728\u71C3\u71D2\uFF0C\u5404\u81EA\u9084\u6709\u8868\u60C5\u3002\n\u5B83\u5011\u6C92\u6709\u6D88\u5931\u3002\u5B83\u5011\u88AB\u56F0\u5728\u5B83\u5468\u570D\uFF0C\u7E7C\u7E8C\u71D2\u8457\u3002\n\u90A3\u500B\u5DE8\u53E3\u7684\u7259\u7E2B\u88E1\u6709\u6771\u897F\u5728\u5F80\u4E0B\u6EF4\u2014\u2014\u67D0\u4E9B\u6771\u897F\u88AB\u56BC\u4E86\u5F88\u4E45\uFF0C\u9084\u6C92\u541E\u5B8C\u3002\n\u7149\u7344\u541E\u566C\u4E86\u81EA\u5DF1\uFF0C\u7559\u4E0B\u4F86\u7684\u662F\u6838\u5FC3\u7684\u610F\u5FD7\u3002\n\u5B83\u51FA\u73FE\u6642\uFF0C\u706B\u7130\u4E0D\u518D\u5206\u8FA8\u500B\u9AD4\u2014\u2014\u842C\u5343\u4EA1\u5F71\u88AB\u7194\u9444\u6210\u540C\u4E00\u5177\u5F62\u9AD4\uFF0C\u5728\u5B83\u8EAB\u908A\u4F4E\u8072\u54C0\u568E\u3002\n\u90A3\u5F35\u5C64\u5C64\u758A\u5408\u7684\u7259\u53E3\uFF0C\u53CD\u8986\u5BA3\u544A\u540C\u4E00\u4EF6\u4E8B\uFF1A\u6B7B\u4EA1\uFF0C\u5F9E\u4F86\u4E0D\u662F\u89E3\u812B\u3002\n\u90A3\u4E9B\u711A\u9996\u6C92\u6709\u6D88\u5931\u2014\u2014\u5B83\u5011\u88AB\u8FEB\u898B\u8B49\uFF0C\u6C38\u9060\u3002"
  descriptionEn: "Look at those skulls—each one still has eyes, each one is still burning, each one still has an expression.\nThey did not disappear. They are held around it, still burning.\nSomething is dripping from between the teeth of that massive maw—something that has been chewed for a long time and has not been swallowed.\nThe inferno consumed itself. What remained is its core will.\nWhen it manifests, fire no longer distinguishes individuals—countless dead shades are fused into a single form, wailing softly around it.\nThose layered, overlapping jaws proclaim the same thing, again and again: death is never release.\nThose burning heads did not disappear—they are made to witness. Forever."
  descriptionJa: "\u3042\u306E\u982D\u9871\u305F\u3061\u3092\u898B\u308D\u2014\u2014\u305D\u308C\u305E\u308C\u306B\u307E\u3060\u773C\u304C\u3042\u308A\u3001\u305D\u308C\u305E\u308C\u304C\u307E\u3060\u71C3\u3048\u3066\u304A\u308A\u3001\u305D\u308C\u305E\u308C\u306B\u307E\u3060\u8868\u60C5\u304C\u3042\u308B\u3002\n\u6D88\u3048\u3066\u3044\u306A\u3044\u3002\u305D\u306E\u5468\u56F2\u306B\u56DA\u308F\u308C\u305F\u307E\u307E\u3001\u71C3\u3048\u7D9A\u3051\u3066\u3044\u308B\u3002\n\u3042\u306E\u5DE8\u5927\u306A\u984E\u306E\u6B6F\u306E\u9699\u9593\u304B\u3089\u4F55\u304B\u304C\u6EF4\u308A\u843D\u3061\u3066\u3044\u308B\u2014\u2014\u9577\u3044\u9593\u565B\u307E\u308C\u3066\u3044\u3066\u3001\u307E\u3060\u98F2\u307F\u8FBC\u307E\u308C\u3066\u3044\u306A\u3044\u4F55\u304B\u304C\u3002\n\u7149\u7344\u306F\u81EA\u3089\u3092\u55B0\u3089\u3063\u305F\u3002\u6B8B\u3063\u305F\u306E\u306F\u3001\u6838\u3068\u306A\u308B\u610F\u5FD7\u3060\u3002\n\u9855\u73FE\u3059\u308B\u3068\u3001\u708E\u306F\u500B\u3092\u533A\u5225\u3057\u306A\u304F\u306A\u308B\u2014\u2014\u7121\u6570\u306E\u4EA1\u5F71\u304C\u4E00\u3064\u306E\u5F62\u306B\u6EB6\u3051\u5408\u3044\u3001\u305D\u306E\u5468\u56F2\u3067\u4F4E\u304F\u5606\u304D\u7D9A\u3051\u308B\u3002\n\u5E7E\u91CD\u306B\u3082\u91CD\u306A\u3063\u305F\u7259\u306E\u53E3\u306F\u3001\u540C\u3058\u3053\u3068\u3092\u4F55\u5EA6\u3082\u5BA3\u544A\u3059\u308B\uFF1A\u6B7B\u306F\u3001\u6C7A\u3057\u3066\u89E3\u653E\u3067\u306F\u306A\u3044\u3002\n\u3042\u306E\u711A\u9996\u305F\u3061\u306F\u6D88\u3048\u3066\u3044\u306A\u3044\u2014\u2014\u6C38\u9060\u306B\u3001\u898B\u5C4A\u3051\u3055\u305B\u3089\u308C\u3066\u3044\u308B\u3002"
