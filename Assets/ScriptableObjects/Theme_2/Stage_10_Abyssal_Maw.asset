  stageName: "\u95BB\u8755\u738B"
  stageIndex: 10
  isBossStage: 1
  description: "\u6C92\u6709\u4EBA\u77E5\u9053\u4ED6\u662F\u5426\u4ECD\u662F\u738B\uFF0C\u6709\u4EBA\u8AAA\u90A3\u53EA\u662F\u7149\u7344\u5728\u541E\u566C\u81EA\u5DF1\u5F8C\uFF0C\u6B98\u7559\u4E0B\u4F86\u7684\u6838\u5FC3\u610F\u5FD7\u3002\n\u7576\u4ED6\u986F\u73FE\uFF0C\u706B\u7130\u4E0D\u518D\u5206\u8FA8\u500B\u9AD4\uFF0C\u842C\u5343\u4EA1\u5F71\u88AB\u7194\u9444\u70BA\u540C\u4E00\u5177\u5F62\u9AD4\uFF0C\u5728\u4ED6\u5468\u8EAB\u4F4E\u8072\u54C0\u568E\u3002\n\u90A3\u5F35\u5C64\u5C64\u758A\u5408\u7684\u7259\u53E3\u53CD\u8986\u5BA3\u544A\u8457\u2014\u2014\u6B7B\u4EA1\uFF0C\u5F9E\u4F86\u4E0D\u662F\u89E3\u812B\u3002\n\u74B0\u7E5E\u4ED6\u7684\u8AF8\u591A\u711A\u9996\uFF0C\u6B63\u662F\u88AB\u4ED6\u4FB5\u8755\u5F8C\u4ECD\u672A\u7184\u6EC5\u7684\u610F\u5FD7\u788E\u7247\uFF0C\u6C38\u9060\u88AB\u8FEB\u898B\u8B49\u7D42\u5C40\u3002"
  rewardBuffCount: 1
  maxHp: 1800
