  m_Name: Stage_7_Purgemind
  m_EditorClassIdentifier: 
  stageName: "\u7344\u885B"
  stageNameEn: Infernal Warden
  stageNameJa: "\u7344\u885B"
  stageIndex: 7
  isBossStage: 0
  description: "\u6CE8\u610F\u90A3\u500B\u706B\u7684\u4F4D\u7F6E\u2014\u2014\u5B83\u5728\u5F8C\u9762\uFF0C\u4E0D\u5728\u5B83\u8EAB\u4E0A\u3002\n\u5B83\u6BD4\u706B\u66F4\u9ED1\uFF0C\u66F4\u5BE6\u3002\u9019\u500B\u6771\u897F\u6C92\u6709\u5728\u71C3\u71D2\u3002\u5B83\u8B93\u706B\u5F85\u5728\u90A3\u88E1\u3002\n\u90A3\u5C0D\u773C\u775B\u4E0D\u5E36\u61A4\u6012\uFF0C\u4E5F\u4E0D\u5E36\u559C\u6085\uFF0C\u53EA\u662F\u5728\u5224\u5B9A\uFF1A\u8AB0\u6709\u8CC7\u683C\u8E0F\u5165\u4E0B\u4E00\u5C64\u3002\n\u4F38\u51FA\u7684\u722A\u4E0D\u662F\u5728\u8FFD\u4F60\uFF0C\u662F\u5728\u5BA3\u544A\uFF1A\u8D8A\u754C\uFF0C\u5FC5\u6709\u4EE3\u50F9\u3002"
  descriptionEn: "Notice where the fire is—behind it, not on it.\nIt is darker than the fire, more solid. This thing is not burning. It is keeping the fire there.\nThose eyes hold no anger, no joy—only judgment: who is worthy to step into the next level.\nThe extended claw is not coming for you. It is declaring: cross the line, and there will be a cost."
  descriptionJa: "\u708E\u306E\u4F4D\u7F6E\u306B\u6CE8\u76EE\u3057\u308D\u2014\u2014\u5F8C\u308D\u306B\u3042\u308B\u3002\u305D\u308C\u81EA\u8EAB\u306E\u4E0A\u306B\u306F\u306A\u3044\u3002\n\u305D\u308C\u306F\u708E\u3088\u308A\u9ED2\u304F\u3001\u3088\u308A\u5B9F\u4F53\u304C\u3042\u308B\u3002\u3053\u306E\u5B58\u5728\u306F\u71C3\u3048\u3066\u3044\u306A\u3044\u3002\u708E\u3092\u305D\u3053\u306B\u5F85\u6A5F\u3055\u305B\u3066\u3044\u308B\u306E\u3060\u3002\n\u53CC\u773C\u306B\u6012\u308A\u3082\u6B53\u559C\u3082\u306A\u3044\u3002\u305F\u3060\u88C1\u5B9A\u304C\u3042\u308B\uFF1A\u8AB0\u304C\u6B21\u306E\u5C64\u3078\u8E0F\u307F\u5165\u308B\u8CC7\u683C\u3092\u6301\u3064\u304B\u3002\n\u4F38\u3070\u3055\u308C\u305F\u722A\u306F\u3042\u306A\u305F\u3092\u8FFD\u3046\u306E\u3067\u306F\u306A\u3044\u3002\u5BA3\u544A\u3057\u3066\u3044\u308B\uFF1A\u8D8A\u3048\u308C\u3070\u3001\u4EE3\u511F\u304C\u3042\u308B\u3002"
